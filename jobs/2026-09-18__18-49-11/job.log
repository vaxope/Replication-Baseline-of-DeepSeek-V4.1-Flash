Sending keys: ["python3 - <<'PY'\nfrom collections import defaultdict\n# cage graph\nedges=[(4,5),(4,18),(5,6),(5,8),(6,7),(7,17),(8,9),(8,11),(9,10),(9,17),(10,11),(10,15),(11,12),(12,13),(12,16),(13,14),(14,15),(15,16),(17,18)]\nadj=defaultdict(list)\nfor a,b in edges: adj[a].append(b); adj[b].append(a)\n# enumerate simple cycles up to 8, canonicalize\nrings=set()\nverts=range(4,19)\nfor s in verts:\n    stack=[(s,[s])]\n    while stack:\n        v,path=stack.pop()\n        for w in adj[v]:\n            if w==s and len(path)>=4:\n                cyc=tuple(sorted(path))\n                rings.add(cyc)\n            elif w not in path and len(path)<8 and w>s:\n                stack.append((w,path+[w]))\nfor r in sorted(rings,key=lambda x:(len(x),x)):\n    # reconstruct cyclic order for readability\n    cyc=list(r)\n    order=[cyc[0]]\n    remaining=set(cyc[1:])\n    while remaining:\n        last=order[-1]\n        nxt=[x for x in remaining if x in adj[last]]\n        if not nxt: break\n        n=nxt[0]; order.append(n); remaining.remove(n)\n    if not remaining:\n        print(len(order), order)\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
