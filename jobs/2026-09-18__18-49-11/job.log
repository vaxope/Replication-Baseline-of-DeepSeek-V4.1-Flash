Sending keys: ["python3 << 'PY'\nimport math\n\ndef sub(a,b): return (a[0]-b[0],a[1]-b[1],a[2]-b[2])\ndef add(a,b): return (a[0]+b[0],a[1]+b[1],a[2]+b[2])\ndef mul(a,s): return (a[0]*s,a[1]*s,a[2]*s)\ndef dot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef norm(a):\n    l=math.sqrt(dot(a,a)); return (a[0]/l,a[1]/l,a[2]/l)\ndef det3(a,b,c):\n    return a[0]*(b[1]*c[2]-b[2]*c[1]) - a[1]*(b[0]*c[2]-b[2]*c[0]) + a[2]*(b[0]*c[1]-b[1]*c[0])\ndef config(center, lig):\n    p1,p2,p3,p4=lig\n    v1,v2,v3,v4=sub(p1,center),sub(p2,center),sub(p3,center),sub(p4,center)\n    d=det3(sub(v1,v4),sub(v2,v4),sub(v3,v4))\n    return ('S' if d>0 else 'R'), d\n\n# approximate cyclohexane chair coordinates\nC = {\n 1:( 1.250, 0.000, 0.000),\n 2:( 0.625, 1.083, 0.250),\n 3:(-0.625, 1.083, 0.250),\n 4:(-1.250, 0.000, 0.000),\n 5:(-0.625,-1.083,-0.250),\n 6:( 0.625,-1.083,-0.250),\n}\n\ndef tetra_complete(center, n1, n2):\n    v1 = sub(C[n1], C[center])\n    v2 = sub(C[n2], C[center])\n    x = norm(add(v1,v2))\n    n = norm(cross(v1,v2))\n    # find a,b so that u = -a*x + b*n has 109.47 deg with v1 and v2,\n    # and is unit. For ideal tetrahedron with v1,v2 ~109.5 deg, choose\n    # a = 1/sqrt(3), b = sqrt(2/3) approximately. Then u plus = -a*x + b*n\n    a=1/math.sqrt(3); b=math.sqrt(2/3)\n    return add(mul(x,-a), mul(n,b)), add(mul(x,-a), mul(n,-b))\n\nfor center, prev, nxt in [(5,4,6),(6,5,1)]:\n    u1,u2 = tetra_complete(center,prev,nxt)\n    print('Center',center,'ring bonds',prev,nxt)\n    print('  completion A',u1,'B',u2)\n\n# For C5, priorities: C6 > C4 > Me > H\n# For C6, priorities: C1 > C5 > Me > H\nprint('\\nC5/C6 configurations for combinations of methyl direction sign:')\n# Represent methyl direction as uA(+normal) or uB(-normal)\nfor s5 in [1,-1]:\n  for s6 in [1,-1]:\n    u5A,u5B = tetra_complete(5,4,6)\n    u6A,u6B = tetra_complete(6,5,1)\n    u5 = u5A if s5==1 else u5B\n    u6 = u6A if s6==1 else u6B\n    # H opposite methyl\n    c5,d5=config(C[5], [ C[6], C[4], add(C[5],u5), sub(C[5],u5) ])\n    c6,d6=config(C[6], [ C[1], C[5], add(C[6],u6), sub(C[6],u6) ])\n    print('methyl dir signs',s5,s6,'-> C5',c5,'C6',c6,'det',round(d5,5),round(d6,5))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
