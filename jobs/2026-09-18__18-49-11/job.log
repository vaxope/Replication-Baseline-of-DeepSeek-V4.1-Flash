r=add(mul(m,cos_t),mul(n,-sin_t))\n# choose c_dir as the more positive-y (exo, toward alkene bridge); d_dir is endo\nif c_dir[1] < d_dir[1]:\n    c_dir,d_dir=d_dir,c_dir\n\n# endo anhydride with either exo-F or endo-F\nfor label, f_dir, h_dir in [\n    ('exo-F (F toward alkene bridge)', c_dir, d_dir),\n    ('endo-F (F toward anhydride bridge)', d_dir, c_dir),\n]:\n    p=dict(pos)\n    p['F']=add(p['C8'], mul(f_dir,1.39))\n    p['H8']=add(p['C8'], mul(h_dir,1.10))\n    print('\\n',label)\n    centers={\n      'C4':['C8','C3a','C5','H4'],\n      'C7':['C8','C7a','C6','H7'],\n      'C3a':['C1','C7a','C4','H3a'],\n      'C7a':['C3','C3a','C7','H7a'],\n    }\n    for cname, pr in centers.items():\n        vol=triple(cname,*pr,p)\n        # calibrate sign separately if needed; print both sign and provisional label\n        print(cname, 'vol=%+.4f'%vol, 'sign=%+d'%(1 if vol>0 else -1))\n    # C8 pseudoasymmetric center; provisional priority F > R ligand > S ligand > H\n    for corename, pr in [\n        ('core A/D: C4=S,C7=R => at C8 priority C7 then C4', ['F','C7','C4','H8']),\n        ('core B/C: C4=R,C7=S => at C8 priority C4 then C7', ['F','C4','C7','H8']),\n    ]:\n        vol=triple('C8',*pr,p)\n        print(corename, 'vol=%+.4f'%vol, 'sign=%+d'%(1 if vol>0 else -1))\nPY\npython3 /tmp/assign_pure.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
