]-1.0*sumF[i] for i in range(3))\n    # C3a priorities: 1=C4(A), 2=carbonyl(C3), 3=C7a(F), 4=H\n    # C7a priorities: 1=C7(D), 2=carbonyl(C1), 3=C3a(E), 4=H\n    print(mode, 'C3a',config(E,A,C3,F,HE)[0], 'C7a',config(F,D,C1,E,HF)[0])\nPY\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
