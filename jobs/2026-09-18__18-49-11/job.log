,math.sin(phi))), math.sqrt(8.0/9.0)))\n        out.append((prefix+str(len(out)+1), add(Cm,mul(unit(d),1.09))))\n    return out\n\nMeHs = {}\nMeHs['bridge-C1']=methyl_Hs(Cm1,C1,'Hm1')\nMeHs['bridge-C4']=methyl_Hs(Cm4,C4,'Hm4')\nMeHs['alkene-C2']=methyl_Hs(Cm2,C2,'Hm2')\nMeHs['alkene-C3']=methyl_Hs(Cm3,C3,'Hm3')\n\n# C7 hydrogens using local tetrahedral directions from bonds to C1 and C4\nH7a=add(C7,mul(other_dir_equal_angles(C7,C1,C4,face=1),1.09))\nH7b=add(C7,mul(other_dir_equal_angles(C7,C1,C4,face=-1),1.09))\nprint('C7 H positions:', tuple(round(x,3) for x in H7a), tuple(round(x,3) for x in H7b))\n\n# Anhydride methine hydrogens at C5/C6.\n# Carbonyl directions are the two equal-angle tetrahedral vacancies; H is the other vacancy.\nfor name,face in [('face_A',1),('face_B',-1)]:\n    d5=other_dir_equal_angles(C5,C4,C6,face=face)\n    d6=other_dir_equal_angles(C6,C1,C5,face=face)\n    # If d is carbonyl direction, H is opposite-face vacancy\n    h5=add(C5,mul(other_dir_equal_angles(C5,C4,C6,face=-face),1.09))\n    h6=add(C6,mul(other_dir_equal_angles(C6,C1,C5,face=-face),1.09))\n    print('\\nOrientation',name,'carbonyl dir z-components:',round(d5[2],2),round(d6[2],2),\n          'H z-components:',round(h5[2],2),round(h6[2],2))\n    print('  H5-H7a/H7b:',round(dist(h5,H7a),2),round(dist(h5,H7b),2),\n          ' H6-H7a/H7b:',round(dist(h6,H7a),2),round(dist(h6,H7b),2))\n    for label,Hs in MeHs.items():\n        d5min=min(dist(h5,h) for _,h in Hs)\n        d6min=min(dist(h6,h) for _,h in Hs)\n        print('   min H5-'+label,round(d5min,2),' min H6-'+label,round(d6min,2))\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
