(n,sin_t))\nd2=add(mul(m,cos_t),mul(n,-sin_t))\nprint('C8 directions d1',d1,'d2',d2)\n\nfor flabel,fdir in [('F above/positive-z',d1),('F below/negative-z',d2)]:\n    p=dict(pos)\n    p['F']=add(p['C8'],mul(fdir,1.39))\n    p['H8']=add(p['C8'],mul(mul(fdir,-1.0),1.10))\n    print('\\n',flabel,'F',p['F'])\n    # C4/C7/C3a/C7a priorities\n    desc={}\n    for c,pr in [\n      ('C4',['C8','C3a','C5','H4']),\n      ('C7',['C8','C7a','C6','H7']),\n      ('C3a',['C1','C7a','C4','H3a']),\n      ('C7a',['C3','C3a','C7','H7a'])]:\n        t=triple(c,*pr,p); desc[c]=label(t)\n        print(c,'vol=%+.4f'%t,desc[c])\n    # C8 descriptors for possible core priorities\n    for core,p2 in [('A/D core 4S,7R', 'C7'),('B/C core 4R,7S','C4')]:\n        p3='C4' if p2=='C7' else 'C7'\n        t=triple('C8','F',p2,p3,'H8',p)\n        print('C8 for',core,'prio F>%s>%s>H:'%(p2,p3),'vol=%+.4f'%t,label(t))\nPY\npython3 /tmp/model2.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
