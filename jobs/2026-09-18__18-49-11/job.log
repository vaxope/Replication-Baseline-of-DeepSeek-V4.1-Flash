Sending keys: ["cat > /tmp/assign.py <<'PY'\nimport numpy as np\n\n# Coordinates for approximate norbornene anhydride core\nC4 = np.array([-1.0, 0.0, 0.0])\nC7 = np.array([1.0, 0.0, 0.0])\nC8 = np.array([0.0, 1.0, 0.0])\nC5 = np.array([-0.8, -1.0, 0.5])\nC6 = np.array([0.8, -1.0, 0.5])\nC3a = np.array([-0.8, -1.0, -0.5])\nC7a = np.array([0.8, -1.0, -0.5])\n\n# Anhydride ring coordinates C3a-C1-O2-C3-C7a\nC1 = np.array([-0.8, -1.6, -1.2])\nC3 = np.array([0.8, -1.6, -1.2])\nO2 = np.array([0.0, -2.2, -0.8])\nO1 = np.array([-1.6, -1.6, -1.8])\nO3 = np.array([1.6, -1.6, -1.8])\n\natoms = {'C4':C4,'C7':C7,'C8':C8,'C5':C5,'C6':C6,'C3a':C3a,'C7a':C7a,'C1':C1,'C3':C3,'O2':O2,'O1':O1,'O3':O3}\n\ndef h_at(center, bs):\n    c = atoms[center]\n    v = np.zeros(3)\n    for b in bs:\n        u = atoms[b]-c\n        u = u/np.linalg.norm(u)\n        v += u\n    return c - 0.7*v/np.linalg.norm(v)\n\natoms['H4'] = h_at('C4', ['C8','C5','C3a'])\natoms['H7'] = h_at('C7', ['C8','C6','C7a'])\natoms['H3a'] = h_at('C3a', ['C1','C4','C7a'])\natoms['H7a'] = h_at('C7a', ['C3','C7','C3a'])\n\ndef orient(center, p1, p2, p3, p4):\n    c=atoms[center]\n    v1=atoms[p1]-c; v2=atoms[p2]-c; v3=atoms[p3]-c; v4=atoms[p4]-c\n    vol = np.dot(v1-v4, np.cross(v2-v4, v3-v4))\n    return vol\n\n# Derived CIP priorities: 1,2,3,4\ncenters={\n 'C4': ['C8','C3a','C5','H4'],\n 'C7': ['C8','C7a','C6','H7'],\n 'C3a': ['C1','C4','C7a','H3a'],\n 'C7a': ['C3','C7','C4','H7a'],\n}\nfor cname, pr in centers.items():\n    vol=orient(cname,*pr)\n    print(cname, 'triple product=', round(vol,4), 'core sign={:+.0f}'.format(np.sign(vol)))\n\n# C8 with F front (+z, toward alkene) or back (-z, toward anhydride).\nfor fz in [0.8,-0.8]:\n    Fpos = C8 + np.array([0.0, 0.6, fz])\n    H8pos = C8 + np.array([0.0, 0.6, -fz])\n    atoms2 = dict(atoms)\n    atoms2['F'] = Fpos\n    atoms2['H8'] = H8pos\n    # Use pseudoasymmetric/geometric substitute: F gets priority 1, H 4,\n    # and paths via C7/C4 get priorities 2/3 according to R/S ordering.\n    # For the core skeleton shown, C7 is R and C4 is S; R > S.\n    def orient2(center, p1,p2,p3,p4):\n        c=atoms2[center]\n        v1=atoms2[p1]-c; v2=atoms2[p2]-c; v3=atoms2[p3]-c; v4=atoms2[p4]-c\n        return np.dot(v1-v4, np.cross(v2-v4, v3-v4))\n    vol = orient2('C8','F','C7','C4','H8')\n    print('Fz=',fz,' C8 triple product=',round(vol,4),'sign=',np.sign(vol))\nPY\npython3 /tmp/assign.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
