Sending keys: ["python3 << 'PY'\nimport numpy as np\nfrom itertools import product\n\n# Regular hexagon ring coordinates (ring order C1-C2-C3-C4-C5-C6)\nring = {\n    1: np.array([1.0, 0.0, 0.0]),\n    2: np.array([0.5, 0.8660, 0.0]),\n    3: np.array([-0.5, 0.8660, 0.0]),\n    4: np.array([-1.0, 0.0, 0.0]),\n    5: np.array([-0.5, -0.8660, 0.0]),\n    6: np.array([0.5, -0.8660, 0.0]),\n}\n# Local substituent directions: +z or -z, at distance 1.\n# H is opposite the substituent.\n\ndef config(center, subs, priorities):\n    # subs: dict atom_id -> coordinate for all four ligands\n    # priorities: list of atom ids in CIP order [1,2,3,4]\n    p1,p2,p3,p4 = [subs[x] for x in priorities]\n    v1,v2,v3,v4 = p1-center, p2-center, p3-center, p4-center\n    det = np.linalg.det(np.array([v1-v4, v2-v4, v3-v4]))\n    return 'S' if det > 0 else 'R', det\n\nprint('C1 configs: priorities OH, C2, C6, H; OH up/down')\nfor oh_z in [1,-1]:\n    subs = {1: ring[1], 'OH': ring[1]+np.array([0,0,oh_z]), 2: ring[2], 6: ring[6], 'H': ring[1]-np.array([0,0,oh_z])}\n    # atom ids: 1=OH, 2=C2, 3=C6, 4=H for convenience\n    pri = [1,2,3,4]\n    c, _ = config(ring[1], subs, pri)\n    print('OH up' if oh_z==1 else 'OH down', c)\n\nprint('\\nC4 configs: priorities C5, C3, CH3, H; C4-Me up/down')\nfor me_z in [1,-1]:\n    subs = {1: ring[5], 2: ring[3], 3: ring[4]+np.array([0,0,me_z]), 4: ring[4]-np.array([0,0,me_z])}\n    # use atom ids arbitrary and priorities [C5, C3, Me, H] = [1,2,3,4]\n    c, _ = config(ring[4], subs, [1,2,3,4])\n    print('C4-Me up' if me_z==1 else 'C4-Me down', c)\n\nprint('\\nC5 configs: priorities C6, C4, CH3, H; C5-Me up/down')\nfor me_z in [1,-1]:\n    subs = {1: ring[6], 2: ring[4], 3: ring[5]+np.array([0,0,me_z]), 4: ring[5]-np.array([0,0,me_z])}\n    c, _ = config(ring[5], subs, [1,2,3,4])\n    print('C5-Me up' if me_z==1 else 'C5-Me down', c)\n\nprint('\\nC6 configs: priorities C1, C5, CH3, H; C6-Me up/down')\nfor me_z in [1,-1]:\n    subs = {1: ring[1], 2: ring[5], 3: ring[6]+np.array([0,0,me_z]), 4: ring[6]-np.array([0,0,me_z])}\n    c, _ = config(ring[6], subs, [1,2,3,4])\n    print('C6-Me up' if me_z==1 else 'C6-Me down', c)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
