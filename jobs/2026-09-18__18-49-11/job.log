_F']=add(pos['F'],mul(fourth_dir('F',['A','G','K1'],pos),1.0))\npos['H_G']=add(pos['G'],mul(fourth_dir('G',['D','F','K3'],pos),1.0))\n\n# C4=A and C7=D priority: E (C8-F) > anhydride path F/G > alkene B/C > H\nprint('\\nSkeleton only (generic anhydride position):')\nvolA=triple('A','E','F','B','H_A',pos)\nvolD=triple('D','E','G','C','H_D',pos)\nprint('A/C4 vol',volA,'D/C7 vol',volD)\n# sign convention: reference with p1->p2->p3 when viewed with p4 away may be R or S; compute\n# For reference, p4 is away; p1(+x)->p2(+y)->p3(-x) is counterclockwise if looking from +z.\n# Let's determine actual from coordinate orientation manually: viewer at +z, x right, y up.\n# p1 right -> p2 up -> p3 left is counterclockwise? from right to up is CCW, up to left CCW. CCW = S.\n# Thus reference with triple sign rv corresponds to S; if rv positive -> S, negative -> R (for this particular order).\nprint('Interpretation: positive reference sign -> S, negative -> R')\n\n# Anhydride carbonyl positions can flip endo/exo, but core A/D may not change much.\n# Add carbonyls above (toward E) for endo / below for exo, and recompute C3a/C7a later.\nfor mode,k1,k3 in [('endo-carbonyls-up',(-0.9,-1.6,0.4),(0.9,-1.6,0.4)),\n                   ('exo-carbonyls-down',(-0.9,-1.6,-1.2),(0.9,-1.6,-1.2))]:\n    p=dict(pos); p['K1']=k1; p['K3']=k3\n    p['H_F']=add(p['F'],mul(fourth_dir('F',['A','G','K1'],p),1.0))\n    p['H_G']=add(p['G'],mul(fourth_dir('G',['D','F','K3'],p),1.0))\n    print('\\n',mode)\n    print('A/C4 vol',triple('A','E','F','B','H_A',p))\n    print('D/C7 vol',triple('D','E','G','C','H_D',p))\n    # At F (C3a), CIP priorities likely K1 (carbonyl) > A (bridgehead) vs G (other C) vs H.\n    # At G similarly K3 > D vs F. Print both possible priority choices.\n    # Compare carbonyl carbon vs bridgehead/other carbon: carbonyl attached O,O,G; A attached E,B,F; G attached D,F,K3.\n    # Carbonyl should be priority 1. A vs G priority difficult; print both.\n    for label,pr in [\n       ('F: K1>A>G>H',['K1','A','G','H_F']),\n       ('F: K1>G>A>H',['K1','G','A','H_F']),\n       ('G: K3>D>F>H',['K3','D','F','H_G']),\n       ('G: K3>F>D>H',['K3','F','D','H_G']),\n    ]:\n       print(label, triple(label.split(':')[0],*pr,p))\nPY\npython3 /tmp/full_assign.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
