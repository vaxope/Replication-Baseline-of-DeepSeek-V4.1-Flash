Sending keys: ["cat > /tmp/model3.py <<'PY'\nimport math\n\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef mul(a,s): return tuple(a[i]*s for i in range(3))\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a): return tuple(x/norm(a) for x in a)\ndef triple(center,p1,p2,p3,p4,p):\n    v1=sub(p[p1],p[p4]); v2=sub(p[p2],p[p4]); v3=sub(p[p3],p[p4])\n    return dot(v1,cross(v2,v3))\ndef desc(v): return 'S' if v>0 else 'R'\n\n# Reference with p4 away; positive -> S\nref={'C':(0,0,0),'p1':(1,0,0),'p2':(0,1,0),'p3':(-1,0,0),'p4':(0,0,-1)}\nprint('ref', triple('C','p1','p2','p3','p4',ref))\n\n# Norbornane cage coordinates: C4/C7 bridgeheads on x axis,\n# one-carbon bridge C8 on +y, alkene bridge C5=C6 on (-y,+z),\n# anhydride bridge C3a-C7a on (-y,-z).\np={\n 'C4':(-1.25,0,0),\n 'C7':( 1.25,0,0),\n 'C8':( 0.0,0.9,0.0),\n 'C5':(-0.67,-0.8,1.1),\n 'C6':( 0.67,-0.8,1.1),\n 'C3a':(-0.77,-0.75,-1.15),\n 'C7a':( 0.77,-0.75,-1.15),\n}\n\ndef fourth(center, bonded, blen=1.05):\n    c=p[center]; s=[0,0,0]\n    for b in bonded:\n        s=add(s,unit(sub(p[b],c)))\n    return add(c,mul(unit(s),-blen))\n\n# hydrogens at bridgeheads and C3a/C7a will be recomputed after choosing carbonyl positions\np['H4']=fourth('C4',['C8','C5','C3a'])\np['H7']=fourth('C7',['C8','C6','C7a'])\n\n# helper to compute H once three other bonds fixed; C1/C3 vary\nfor face in ['endo_plus_z','exo_minus_z']:\n    pp=dict(p)\n    if face=='endo_plus_z':\n        c1_dir=(0.0,0.2,1.0)\n        c3_dir=(0.0,0.2,1.0)\n    else:\n        c1_dir=(0.0,-0.2,-1.0)\n        c3_dir=(0.0,-0.2,-1.0)\n    pp['C1']=add(pp['C3a'],mul(unit(c1_dir),1.52))\n    pp['C3']=add(pp['C7a'],mul(unit(c3_dir),1.52))\n    # H opposite sum of other three bond vectors\n    pp['H3a']=fourth('C3a',['C4','C7a','C1'],1.05)\n    pp['H7a']=fourth('C7a',['C7','C3a','C3'],1.05)\n    print('\\nFace',face)\n    for atom,pr in [\n      ('C4',['C8','C3a','C5','H4']),\n      ('C7',['C8','C7a','C6','H7']),\n      ('C3a',['C1','C7a','C4','H3a']),\n      ('C7a',['C3','C3a','C7','H7a']),\n    ]:\n        t=triple(atom,*pr,pp)\n        print(atom, desc(t), 'val', round(t,3))\n    # C8 F on +z and -z\n    for fz in [1.0,-1.0]:\n        q=dict(pp)\n        q['F']=add(q['C8'],(0,0,fz*1.39))\n        q['H8']=add(q['C8'],(0,0,-fz*1.09))\n        # priorities in A/D core: F > C7(R) > C4(S) > H\n        tA=triple('C8','F','C7','C4','H8',q)\n        # priorities in B/C core: F > C4(R) > C7(S) > H\n        tB=triple('C8','F','C4','C7','H8',q)\n        print('  Fz',fz,'coreA/D ->',desc(tA),'coreB/C ->',desc(tB))\n\n    # If core labels at C4/C7 are as output, choose appropriate C8\n    t4=triple('C4','C8','C3a','C5','H4',pp); t7=triple('C7','C8','C7a','C6','H7',pp)\n    print('  actual C4/C7:',desc(t4),desc(t7))\n    for fz in [1.0,-1.0]:\n        q=dict(pp); q['F']=add(q['C8'],(0,0,fz*1.39)); q['H8']=add(q['C8'],(0,0,-fz*1.09))\n        if desc(t4)=='S' and desc(t7)=='R':\n            t=triple('C8','F','C7','C4','H8',q)\n        else:\n            t=triple('C8','F','C4','C7','H8',q)\n        print('  appropriate C8 desc Fz',fz,'=',desc(t))\nPY\npython3 /tmp/model3.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
