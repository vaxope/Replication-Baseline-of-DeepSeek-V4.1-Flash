Sending keys: ["python3 - <<'PY'\nimport math, random\n\natoms=['A','D','S','B','C','E','F']\nidx={a:i for i,a in enumerate(atoms)}\n# starting coords\nstart={\n 'A':(-1.1,0.0,0.4),'D':(1.1,0.0,0.4),'S':(0.0,0.0,1.9),\n 'B':(-1.0,-1.1,-0.6),'C':(1.0,-1.1,-0.6),\n 'E':(-1.0,1.1,-0.6),'F':(1.0,1.1,-0.6)\n}\nbonds=[('A','S',1.80),('D','S',1.80),('A','B',1.52),('B','C',1.34),('C','D',1.52),('A','E',1.52),('E','F',1.54),('F','D',1.52)]\nangles=[('S','A','B',109.47),('S','A','E',109.47),('B','A','E',109.47),\n        ('S','D','C',109.47),('S','D','F',109.47),('C','D','F',109.47),\n        ('A','B','C',120.0),('B','C','D',120.0),('A','S','D',97.0),\n        ('A','E','F',109.0),('D','F','E',109.0)]\n\ndef sub(p,q): return tuple(p[i]-q[i] for i in range(3))\ndef add(p,q): return tuple(p[i]+q[i] for i in range(3))\ndef mul(a,p): return tuple(a*x for x in p)\ndef dot(u,v): return sum(u[i]*v[i] for i in range(3))\ndef cross(u,v): return (u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0])\ndef norm(u): return math.sqrt(dot(u,u))\ndef unit(u):\n    n=norm(u); return tuple(x/n for x in u)\ndef angle(u,v):\n    c=dot(unit(u),unit(v)); c=max(-1,min(1,c)); return math.degrees(math.acos(c))\n\ndef objective(coords):\n    E=0.0\n    for a,b,L in bonds:\n        d=norm(sub(coords[a],coords[b]))\n        E += 100.0*(d-L)**2\n    for a,b,c,th in angles:\n        u=sub(coords[a],coords[b]); v=sub(coords[c],coords[b])\n        E += (angle(u,v)-th)**2\n    return E\n\ndef coords_array(coords):\n    arr=[]\n    for a in atoms: arr += list(coords[a])\n    return arr\ndef array_coords(arr):\n    return {a:tuple(arr[3*i:3*i+3]) for i,a in enumerate(atoms)}\n\ndef grad(arr):\n    g=[0.0]*len(arr); eps=1e-5\n    f0=objective(array_coords(arr))\n    for i in range(len(arr)):\n        old=arr[i]; arr[i]=old+eps\n        f=objective(array_coords(arr)); arr[i]=old\n        g[i]=(f-f0)/eps\n    return g\n\nbest=None\nfor trial in range(4):\n    coords={a:tuple(x+random.uniform(-0.1,0.1) for x in start[a]) for a in atoms}\n    arr=coords_array(coords)\n    lr=0.002\n    for it in range(4000):\n        g=grad(arr)\n        arr=[arr[i]-lr*g[i] for i in range(len(arr))]\n        if it%1000==999: lr*=0.5\n    val=objective(array_coords(arr))\n    if best is None or val<best[0]:\n        best=(val,arr[:])\n    print('trial',trial,'objective',round(val,4))\nval,arr=best\ncoords=array_coords(arr)\nprint('best objective',round(val,6))\nfor a in atoms: print(a,tuple(round(x,4) for x in coords[a]))\n\ndef determinant(center,p1,p2,p3,p4):\n    v1=sub(p1,center); v2=sub(p2,center); v3=sub(p3,center)\n    return dot(v1,cross(v2,v3))\ndef config(center,p1,p2,p3,p4):\n    D=determinant(center,p1,p2,p3,p4)\n    return 'R' if D<0 else 'S', D\n\n# fourth tetrahedral bond at A and D from three known ring bonds\ndef fourth(center,p1,p2,p3):\n    u=unit(sub(p1,center)); v=unit(sub(p2,center)); w=unit(sub(p3,center))\n    return unit(tuple(-(u[i]+v[i]+w[i]) for i in range(3)))\ndA=fourth(coords['A'],coords['S'],coords['B'],coords['E'])\ndD=fourth(coords['D'],coords['S'],coords['C'],coords['F'])\nMeA=add(coords['A'],dA); MeD=add(coords['D'],dD)\nprint('C4 config',config(coords['A'],coords['S'],coords['E'],coords['B'],MeA)[0])\nprint('C7 config',config(coords['D'],coords['S'],coords['F'],coords['C'],MeD)[0])\n\ndef tetra_other(center,p1,p2):\n    u1=unit(sub(p1,center)); u2=unit(sub(p2,center))\n    n=unit(cross(u1,u2)); w=mul(-1,add(u1,u2))\n    q=math.sqrt(max(0.0,1.0-dot(w,w)/4.0))\n    u3=add(mul(0.5,w),mul(q,n)); u4=add(mul(0.5,w),mul(-q,n))\n    return u3,u4\n\nfor mode in ['exo','endo']:\n    H_E=[]; G_E=[]; H_F=[]; G_F=[]\n    u3,u4=tetra_other(coords['E'],coords['A'],coords['F'])\n    # exo: substituent on +z side (same side as S); endo: -z side\n    if u3[2] > u4[2]:\n        up,down=u3,u4\n    else:\n        up,down=u4,u3\n    if mode=='exo': Gdir,Hdir=up,down\n    else: Gdir,Hdir=down,up\n    G_E=add(coords['E'],Gdir); H_E=add(coords['E'],Hdir)\n    u3,u4=tetra_other(coords['F'],coords['D'],coords['E'])\n    if u3[2] > u4[2]:\n        up,down=u3,u4\n    else:\n        up,down=u4,u3\n    if mode=='exo': Gdir,Hdir=up,down\n    else: Gdir,Hdir=down,up\n    G_F=add(coords['F'],Gdir); H_F=add(coords['F'],Hdir)\n    # CIP at C3a(E): 1=G,2=A,3=F,4=H ; at C7a(F): 1=G,2=D,3=E,4=H\n    cfgE=config(coords['E'],G_E,coords['A'],coords['F'],H_E)[0]\n    cfgF=config(coords['F'],G_F,coords['D'],coords['E'],H_F)[0]\n    print(mode,'C3a',cfgE,'C7a',cfgF)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
