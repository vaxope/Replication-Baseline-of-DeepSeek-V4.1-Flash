Sending keys: ["python3 - <<'PY'\nimport math\nC=0.1/106.87/0.1\nKw=1e-14\nb1=10**-2.2; b2=10**-5.7; b3=10**-12.3; b4=10**-21.6\nprint('C',C,'stoich V',3*C*1000)\nprint('Exact saturated endpoint (all Fe dissolved, solution just saturated):')\nfor Ksp in [4e-38,2e-38,1e-38,7e-39,4e-39,2.79e-39,1e-39,2e-37,5e-37,1.1e-36,2e-36,5e-36,1e-35]:\n    lo,hi=1e-10,1.0\n    def g(h):\n        # total dissolved Fe at saturation against free Fe3+ from Ksp\n        fe=Ksp*h**3/Kw**3\n        D=1+b1/h+b2/h**2+b3/h**3+b4/h**4\n        return fe*D-C\n    # g should decrease/increase; use brent-like bisection find sign change\n    glo,ghi=g(lo),g(hi)\n    if glo*ghi>0:\n        # try wider region\n        hs=[10**(-x/2) for x in range(0,61)]\n        found=False\n        for a,b in zip(hs[:-1],hs[1:]):\n            if g(a)*g(b)<=0:\n                lo,hi=a,b; found=True; break\n        if not found:\n            print('no root Ksp',Ksp,glo,ghi); continue\n    for _ in range(400):\n        mid=(lo+hi)/2\n        if g(lo)*g(mid)<=0: hi=mid\n        else: lo=mid\n    h=(lo+hi)/2\n    fe=Ksp*h**3/Kw**3\n    feoh=b1*fe/h; feoh2=b2*fe/h**2; feoh3=b3*fe/h**3; feoh4=b4*fe/h**4\n    Cl=h+3*fe+2*feoh+feoh2-feoh4-Kw/h\n    V=Cl/C*28.05  # scale relative to stoich\n    V=Cl*1000\n    print(f'Ksp={Ksp:.3e} pH={-math.log10(h):.3f} V={V:.2f} mL freeFe={fe:.3e} avg charge={(3*fe+2*feoh+feoh2-feoh4)/C:.3f}')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
