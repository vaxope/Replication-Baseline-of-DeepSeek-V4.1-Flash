Sending keys: ["python3 - <<'PY'\nfrom itertools import combinations\n# cage atom indices 4..18\ncage=list(range(4,19))\nedges=[(4,5),(4,18),(5,6),(5,8),(6,7),(7,17),(8,9),(8,11),(9,10),(9,17),(10,11),(10,15),(11,12),(12,13),(12,16),(13,14),(14,15),(15,16),(17,18)]\nassert len(edges)==20\nfor cut in combinations(range(len(edges)),4):\n    adj={i:set() for i in cage}\n    for k,(a,b) in enumerate(edges):\n        if k not in cut:\n            adj[a].add(b); adj[b].add(a)\n    seen=set(); comps=[]\n    for v in cage:\n        if v in seen: continue\n        stack=[v]; seen.add(v); comp=[]\n        while stack:\n            x=stack.pop(); comp.append(x)\n            for y in adj[x]:\n                if y not in seen:\n                    seen.add(y); stack.append(y)\n        comps.append(comp)\n    if len(comps)==2 and sorted(map(len,comps))==[5,10]:\n        comps=sorted(comps,key=len)\n        print('CUT EDGES:', [edges[k] for k in cut])\n        print('5-CPD:', sorted(comps[0]))\n        print('10-CORE:', sorted(comps[1]))\n        print()\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
