Sending keys: ['python3 - <<\'PY\'\nimport re\n\ndef parse(smiles, name):\n    atoms=[]  # (symbol, chirality)\n    adj={}\n    ring={}\n    branch_stack=[]\n    prev=None\n    bond=1\n    i=0\n    while i < len(smiles):\n        ch=smiles[i]\n        if ch == \'[\':\n            j=smiles.index(\']\', i)\n            tok=smiles[i+1:j]\n            # element is first alpha characters (C, N, O, etc.)\n            m=re.match(r\'([A-Z][a-z]?|[a-z])\', tok)\n            el=m.group(1) if m else \'?\'\n            chir=\'\'\n            if \'@\' in tok:\n                chir=\'@@\' if \'@@\' in tok else \'@\'\n            idx=len(atoms)\n            atoms.append((el,chir,tok))\n            adj[idx]=[]\n            if prev is not None:\n                adj[prev].append((idx,bond)); adj[idx].append((prev,bond)); bond=1\n            prev=idx\n            i=j+1\n            continue\n        elif ch == \'(\':\n            branch_stack.append(prev)\n        elif ch == \')\':\n            prev=branch_stack.pop()\n        elif ch == \'=\':\n            bond=2\n        elif ch == \'#\':\n            bond=3\n        elif ch.isdigit():\n            n=int(ch)\n            if n in ring:\n                other=ring.pop(n)\n                adj[prev].append((other,bond)); adj[other].append((prev,bond)); bond=1\n            else:\n                ring[n]=prev\n        elif ch.isalpha():\n            # organic subset atom, may be Cl/Br\n            if i+1 < len(smiles) and smiles[i:i+2] in (\'Cl\',\'Br\'):\n                el=smiles[i:i+2]; i+=1\n            else:\n                el=ch\n            idx=len(atoms)\n            atoms.append((el,\'\',\'\'))\n            adj[idx]=[]\n            if prev is not None:\n                adj[prev].append((idx,bond)); adj[idx].append((prev,bond)); bond=1\n            prev=idx\n        i+=1\n    print(\'====\', name, \'heavy atoms\', len(atoms))\n    for idx,(el,chir,tok) in enumerate(atoms):\n        if chir:\n            neigh=\' \'.join(f\'{j}{"=" if b==2 else "#" if b==3 else ""}\' for j,b in adj[idx])\n            print(f\'{idx:2d} {el:2s} {chir:2s} : {neigh}\')\n    return atoms,adj\n\nsmis={\n\'A\':\'O=C(OC)[C@H]1[C@@H](C=C2)[C@@H]3[C@@H]([C@@H]4[C@H]3[C@@H]5C=C[C@H]4C5)[C@@H]2[C@H]1C(OC)=O\',\n\'B\':\'O=C(OC)[C@@H]1[C@@H](C=C2)[C@@H]3[C@@H]([C@@H]4[C@H]3[C@H]5C=C[C@@H]4C5)[C@@H]2[C@H]1C(OC)=O\',\n\'C\':\'O=C(OC)[C@@H]1[C@H](C=C2)[C@@H]3[C@@H]([C@H]4[C@@H]3[C@@H]5C=C[C@H]4C5)[C@H]2[C@@H]1C(OC)=O\',\n\'D\':\'O=C(OC)[C@@H]1[C@@H](C=C2)[C@@H]3[C@@H]([C@H]4[C@@H]3[C@H]5C=C[C@@H]4C5)[C@@H]2[C@@H]1C(OC)=O\'\n}\nfor k in \'ABCD\':\n    parse(smis[k], k)\nPY\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
