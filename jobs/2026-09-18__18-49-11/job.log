Sending keys: ["python3 - <<'PY'\nimport math\n\ndef vsub(a,b): return (a[0]-b[0],a[1]-b[1],a[2]-b[2])\ndef vadd(a,b): return (a[0]+b[0],a[1]+b[1],a[2]+b[2])\ndef vmul(a,s): return (a[0]*s,a[1]*s,a[2]*s)\ndef vdot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\ndef vcross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef vnorm(a): return math.sqrt(vdot(a,a))\ndef vunit(a):\n    n=vnorm(a); return vmul(a,1.0/n)\ndef dist(a,b): return vnorm(vsub(a,b))\ndef tetra_vac(C,A,B):\n    # return the two unit directions for the missing bonds, given existing bonds C->A and C->B\n    u=vunit(vsub(A,C)); v=vunit(vsub(B,C))\n    s=vadd(u,v)\n    q=vunit(vmul(s,-1.0))\n    n=vunit(vcross(u,v))\n    cosphi=-1.0/3.0/(-vdot(u,q)) if abs(vdot(u,q))>1e-9 else None\n    # The above assumes u.w=-1/3 and w=q*cosphi +- n*sinphi\n    c=-1.0/3.0/vdot(u,q)\n    # but if q is exactly opposite sum, c should be (1/3)/|projection|; guard\n    c=max(-1.0,min(1.0,c))\n    sphi=math.sqrt(max(0.0,1.0-c*c))\n    return vadd(vmul(q,c),vmul(n,sphi)), vadd(vmul(q,c),vmul(n,-sphi))\n\ndef fourth_dir(C,Ns):\n    s=(0,0,0)\n    for N in Ns: s=vadd(s,vunit(vsub(N,C)))\n    return vunit(vmul(s,-1.0))\n\ndef methyl_Hs(Cm,Cring,prefix):\n    a=vunit(vsub(Cring,Cm))\n    tmp=(1.0,0.0,0.0) if abs(a[0])<0.9 else (0.0,1.0,0.0)\n    e1=vunit(vcross(a,tmp)); e2=vcross(a,e1)\n    out=[]\n    for ang in (0.0,2*math.pi/3,4*math.pi/3):\n        d=vadd(vmul(a,-1.0/3.0),vmul(vadd(vmul(e1,math.cos(ang)),vmul(e2,math.sin(ang))),math.sqrt(8.0/9.0)))\n        out.append((prefix+str(len(out)+1),vadd(Cm,vmul(vunit(d),1.09))))\n    return out\n\n# More realistic norbornane skeleton\nB1=( 1.15, 0.00, 0.00)   # right bridgehead\nB2=(-1.15, 0.00, 0.00)   # left bridgehead\nA1=( 0.75,-1.25,-0.80)   # anhydride-side carbon C5, bonded to B1 and A2\nA2=(-0.75,-1.25,-0.80)   # anhydride-side carbon C6, bonded to B2 and A1\nE1=( 0.75, 1.25,-0.80)   # alkene carbon C2, bonded to B1 and E2\nE2=(-0.75, 1.25,-0.80)   # alkene carbon C3, bonded to B2 and E1\nC7=( 0.00, 0.00, 1.02)   # methano bridge carbon\n\n# sanity distances\nprint('Framework bond distances:')\nfor name,a,b in [('C1-C2',B1,E1),('C2=C3',E1,E2),('C3-C4',E2,B2),('C4-C5',B2,A2),('C5-C6',A2,A1),('C6-C1',A1,B1),('C1-C7',B1,C7),('C4-C7',B2,C7)]:\n    print(' ',name,round(dist(a,b),3))\nprint(' C1...C4',round(dist(B1,B2),3))\n\n# Methyl carbons\nMeB1=vadd(B1,vmul(fourth_dir(B1,[A1,E1,C7]),1.50))\nMeB2=vadd(B2,vmul(fourth_dir(B2,[A2,E2,C7]),1.50))\n# trigonal alkene methyls\nMeE1=vadd(E1,vmul(vunit(vmul(vadd(vunit(vsub(B1,E1)),vunit(vsub(E2,E1))),-1.0)),1.50))\nMeE2=vadd(E2,vmul(vunit(vmul(vadd(vunit(vsub(B2,E2)),vunit(vsub(E1,E2))),-1.0)),1.50))\n\nMeH={}\nMeH['bridgehead-Me1']=methyl_Hs(MeB1,B1,'b1')\nMeH['bridgehead-Me2']=methyl_Hs(MeB2,B2,'b2')\nMeH['alkene-Me1']=methyl_Hs(MeE1,E1,'e1')\nMeH['alkene-Me2']=methyl_Hs(MeE2,E2,'e2')\n\n# C7 hydrogens from tetrahedral vacancies\nv7=tetra_vac(C7,B1,B2)\nH7a=vadd(C7,vmul(v7[0],1.09)); H7b=vadd(C7,vmul(v7[1],1.09))\nprint('\\nC7 hydrogens:')\nfor h in (H7a,H7b): print(' ',tuple(round(x,3) for x in h))\n\n# Maleic anhydride methine positions for both orientations at each A center\nvA1=tetra_vac(A1,B1,A2)\nvA2=tetra_vac(A2,B2,A1)\nfor label,which in [('endo orientation (carbonyls up; methine down)',0),('exo orientation (carbonyls down; methine up)',1)]:\n    # choose the methine direction to be one of the two tetrahedral vacancies\n    h1=vadd(A1,vmul(vA1[which],1.09)); h2=vadd(A2,vmul(vA2[which],1.09))\n    print('\\n'+label)\n    print('  methine H z:',round(h1[2],2),round(h2[2],2))\n    for hname,h in [('H5',h1),('H6',h2)]:\n        print(' ',hname,'to C7 H:',round(dist(h,H7a),2),round(dist(h,H7b),2))\n    for mname,Hs in MeH.items():\n        dmins=[min(dist(h,hh) for _,hh in Hs) for h in (h1,h2)]\n        print('  min methine-H to',mname,':',round(min(dmins),2))\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
