Sending keys: ["cat > /tmp/stereo.py <<'PY'\nimport math\n\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef mul(a,s): return tuple(a[i]*s for i in range(3))\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a):\n    n=norm(a); return tuple(x/n for x in a)\ndef triple(center,p1,p2,p3,p4,p):\n    v1=sub(p[p1],p[p4]); v2=sub(p[p2],p[p4]); v3=sub(p[p3],p[p4])\n    return dot(v1,cross(v2,v3))\ndef label(v): return 'S' if v>0 else 'R'\ndef fourth(center, bonded, p, blen=1.05):\n    c=p[center]; s=[0.0,0.0,0.0]\n    for b in bonded:\n        s=add(s,unit(sub(p[b],c)))\n    return add(c,mul(unit(s),-blen))\n\n# known reference: p4 away, 1->2->3 CCW is S, positive triple\nref={'C':(0,0,0),'p1':(1,0,0),'p2':(0,1,0),'p3':(-1,0,0),'p4':(0,0,-1)}\nprint('reference triple (positive -> S):', triple('C','p1','p2','p3','p4',ref))\n\nbase={\n 'C4':(0.0,0.0,1.0),\n 'C7':(0.0,0.0,-1.0),\n 'C8':(0.0,1.0,0.0),\n # left bridge = alkene\n 'C5':(-1.1,-0.6,0.75),\n 'C6':(-1.1,-0.6,-0.75),\n # right bridge = anhydride\n 'C3a':(1.1,-0.6,-0.75),\n 'C7a':(1.1,-0.6,0.75),\n}\nbase['H4']=fourth('C4',['C8','C5','C3a'],base)\nbase['H7']=fourth('C7',['C8','C6','C7a'],base)\n\nfor mode, yoff in [('endo anhydride (+y side)',1.25),('exo anhydride (-y side)',-1.25)]:\n    p=dict(base)\n    # place carbonyl carbons on selected face of the anhydride bridge\n    p['C1']=add(p['C3a'],(0.0,yoff,-0.25))\n    p['C3']=add(p['C7a'],(0.0,yoff, 0.25))\n    p['H3a']=fourth('C3a',['C4','C7a','C1'],p)\n    p['H7a']=fourth('C7a',['C7','C3a','C3'],p)\n    print('\\n===',mode,'===')\n    core={}\n    for c,prio in [\n      ('C4',['C8','C3a','C5','H4']),\n      ('C7',['C8','C7a','C6','H7']),\n      ('C3a',['C1','C4','C7a','H3a']),\n      ('C7a',['C3','C7','C3a','H7a'])]:\n        t=triple(c,*prio,p); core[c]=label(t)\n        print(c, core[c], 'vol=%+.4f'%t)\n    # F possibilities at C8: direction toward anhydride (+x) or alkene (-x)\n    for flab, xdir in [('F endo toward anhydride (+x)',1.0),('F exo toward alkene (-x)',-1.0)]:\n        q=dict(p)\n        # direction derived for C8 substituents: (±0.882, 0.471, 0)\n        q['F']=add(q['C8'],(xdir*0.882,0.471,0))\n        q['H8']=add(q['C8'],(-xdir*0.882,0.471,0))\n        # C8 priorities depending on core C4/C7 descriptors\n        if core['C4']=='S' and core['C7']=='R':\n            pr8=['F','C7','C4','H8']\n        elif core['C4']=='R' and core['C7']=='S':\n            pr8=['F','C4','C7','H8']\n        else:\n            pr8=None\n        t=triple('C8',*pr8,q) if pr8 else 0\n        print(' ',flab,'C8=',label(t) if pr8 else '?','vol=%+.4f'%t)\nPY\npython3 /tmp/stereo.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
