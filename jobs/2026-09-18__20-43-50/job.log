ppend(add(methyl_c, mul(d,1.09)))\n    return out\n\nH_me1=methyl_Hs(C1,Me1)\nH_me4=methyl_Hs(C4,Me4)\nH_me2=methyl_Hs(C2,Me2)\nH_me3=methyl_Hs(C3,Me3)\n\n# bridge hydrogens at C7\nd7 = tetra_dir([sub(C1,C7),sub(C4,C7), (0,1,0)])\n# Need two H directions; simplify: use two directions obtained by adding/subtracting perpendicular component\nb=unit(add(sub(C1,C7),sub(C4,C7)))\nperp=unit(cross(sub(C1,C7),sub(C4,C7)))\n# d7 above and below plane\nH7a=add(C7, mul(unit(add(mul(b,0.4), mul(perp,0.916))),1.09))\nH7b=add(C7, mul(unit(add(mul(b,0.4), mul(perp,-0.916))),1.09))\n\n# Two tetrahedral substituent directions at C5 given known C1 and C6 bonds\ndef two_tetra(center, a, b):\n    ua=unit(sub(a,center)); ub=unit(sub(b,center))\n    bsec=unit(add(ua,ub))\n    p=unit(cross(ua,ub))\n    # For ideal tetrahedron, remaining two directions are -bsec*cos(54.7) +/- p*sin(54.7)\n    ca=math.cos(math.radians(54.7356)); sa=math.sin(math.radians(54.7356))\n    d1=add(mul(bsec,-ca), mul(p, sa))\n    d2=add(mul(bsec,-ca), mul(p,-sa))\n    return unit(d1),unit(d2)\n\nd5a,d5b=two_tetra(C5,C1,C6)\nd6a,d6b=two_tetra(C6,C4,C5)\n\ndef mirror(v): return (-v[0],v[1],v[2])\n\ndef analyze(name, c5_sub, c6_sub):\n    # c5_sub and c6_sub are normalized direction choices for carbonyl carbon; H is the other direction\n    H5=add(C5, mul(c5_sub,1.09))\n    C5carbonyl=add(C5,mul(c5_sub,1.50))\n    H6=add(C6, mul(c6_sub,1.09))\n    print('\\n'+name)\n    print('H5', tuple(round(x,2) for x in H5), 'H6', tuple(round(x,2) for x in H6))\n    def min_dist(H, Hset): return min(norm(sub(H,h)) for h in Hset)\n    def max_dist(H, Hset): return max(norm(sub(H,h)) for h in Hset)\n    for label,Hset in [('Me1',H_me1),('Me4',H_me4),('Me2',H_me2),('Me3',H_me3)]:\n        print(label, 'H5 min %.2f max %.2f'%(min_dist(H5,Hset),max_dist(H5,Hset)),\n              'H6 min %.2f max %.2f'%(min_dist(H6,Hset),max_dist(H6,Hset)))\n    for label,H in [('H7a',H7a),('H7b',H7b)]:\n        print(label,'to H5 %.2f H6 %.2f'%(norm(sub(H,H5)),norm(sub(H,H6))))\n\n# Choose carbonyl direction based on z sign of direction; test both choices and mirror at C6.\n# orientation 1: carbonyl toward +z (up toward C7 side); H down\nanalyze('C=O up (+z), H down', d5a if d5a[2]>d5b[2] else d5b, mirror(d5a if d5a[2]>d5b[2] else d5b))\n# orientation 2: C=O down (-z)\nanalyze('C=O down (-z), H up', d5a if d5a[2]<d5b[2] else d5b, mirror(d5a if d5a[2]<d5b[2] else d5b))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
