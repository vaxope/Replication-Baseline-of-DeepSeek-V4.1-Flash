Sending keys: ["python3 - <<'PY'\nimport math\n\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(*vs): return tuple(sum(v[i] for v in vs) for i in range(3))\ndef scale(s,v): return tuple(s*x for x in v)\ndef norm(v):\n    n=math.sqrt(sum(x*x for x in v)); return tuple(x/n for x in v)\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef det3(a,b,c): return dot(a,cross(b,c))\n\ndef rs(center,p1,p2,p3):\n    # p4 direction = opposite sum of the three bond directions\n    d1=norm(sub(p1,center)); d2=norm(sub(p2,center)); d3=norm(sub(p3,center))\n    d4=norm(scale(-1, add(d1,d2,d3)))\n    t=det3(sub(d1,d4), sub(d2,d4), sub(d3,d4))\n    return ('R' if t<0 else 'S'), t, d4\n\n# Symmetric cage approximation\nC4=(0,0,1)   # A, methyl-bearing bridgehead\nC7=(0,0,-1)  # B, methyl-bearing bridgehead\nS=(0,1,0)    # sulfur one-atom bridge\nC3a=(1,-0.5,0.5)\nC7a=(1,-0.5,-0.5)\nC5=(-1,-0.5,0.5)\nC6=(-1,-0.5,-0.5)\n\n# C4 priorities: 1=S, 2=C3a, 3=C5, 4=methyl\nlab4,t4,me4=rs(C4,S,C3a,C5)\n# C7 priorities: 1=S, 2=C7a, 3=C6, 4=methyl\nlab7,t7,me7=rs(C7,S,C7a,C6)\nprint('C4:',lab4,t4,'methyl dir',me4)\nprint('C7:',lab7,t7,'methyl dir',me7)\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /tmp/parse_smiles2.py << 'PY'\nimport re\n\ndef parse(smiles):\n    atoms=[]; bonds=[]; stack=[]; rings={}; prev=None; pending=1; i=0\n    def add_atom(elem, h, raw, bracketed):\n        nonlocal prev, pending\n        idx=len(atoms)\n        atoms.append({'elem':elem,'H_explicit':h,'bracket':bracketed,'raw':raw})\n        if prev is not None:\n            bonds.append((prev,idx,pending))\n        prev=idx\n        pending=1\n    while i<len(smiles):\n        c=smiles[i]\n        if c=='(':\n            stack.append(prev); i+=1; continue\n        if c==')':\n            prev=stack.pop(); i+=1; continue\n        if c in '-=#:':\n            pending={'-':1,'=':2,'#':3,':':4}[c]; i+=1; continue\n        if c.isdigit():\n            n=int(c)\n            if n in rings:\n                a=rings.pop(n)\n                bonds.append((prev,a,pending))\n            else:\n                rings[n]=prev\n            pending=1; i+=1; continue\n        if c=='[':\n            j=smiles.index(']',i)\n            tok=smiles[i+1:j]\n            i=j+1\n            m=re.match(r'([A-Z][a-z]?)([^]]*)',tok)\n            elem=m.group(1); rest=m.group(2)\n            hs=[int(mm.group(1) or 1) for mm in re.finditer(r'H(\\d*)',rest)]\n            h=sum(hs)\n            add_atom(elem,h,tok,True)\n            continue\n        if c.isalpha():\n            elem=c\n            if i+1<len(smiles) and smiles[i:i+2] in ('Cl','Br'):\n                elem=smiles[i:i+2]; i+=1\n            add_atom(elem,None,c,False)\n            i+=1; continue\n        i+=1\n    print('SMILES:',smiles)\n    print('atoms',len(atoms))\n    for k,a in enumerate(atoms): print(k,a)\n    print('bonds')\n    for b in bonds: print(b)\n    val={'C':4,'O':2}\n    v=[0]*len(atoms)\n    for a,b,o in bonds: v[a]+=o; v[b]+=o\n    hs=[]\n    print('atoms with valence/H')\n    for k,a in enumerate(atoms):\n        h=a['H_explicit'] if a['H_explicit'] is not None else max(0,val.get(a['elem'],0)-v[k])\n        hs.append(h)\n        print(k,a['elem'],'val',v[k],'H',h,'stereo',a['raw'])\n    from collections import Counter\n    cnt=Counter(a['elem'] for a in atoms)\n    print('formula',dict(cnt),'H total',sum(hs))\n\nsm='O=C(OC)[C@H]1[C@@H](C=C2)[C@@H]3[C@@H]([C@@H]4[C@H]3[C@@H]5C=C[C@H]4C5)[C@@H]2[C@H]1C(OC)=O'\nparse(sm)\nPY\npython3 /tmp/parse_smiles2.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
