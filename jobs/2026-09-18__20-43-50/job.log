(): print(k,'C',tuple(round(x,2) for x in {'Me1':Me1,'Me4':Me4,'Me2':Me2,'Me3':Me3}[k]))\n# local directions at C5\nd5a,d5b=other_two(C['C5'],C['C4'],C['C6'])\nd_up=d5a if d5a[2]>d5b[2] else d5b\nd_down=d5b if d5a[2]>d5b[2] else d5a\nfor label,dC in [('endo_anhydride_up',d_up),('exo_anhydride_down',d_down)]:\n    C5c=add(C['C5'],mul(dC,1.50)); C6c=(-C5c[0],C5c[1],C5c[2])\n    print('\\n'+label,'C5c/C6c',tuple(round(x,2) for x in C5c),tuple(round(x,2) for x in C6c))\n    for k,Hs in Hsets.items():\n        ds=[dist(h,C5c) for h in Hs]+[dist(h,C6c) for h in Hs]\n        print(k,'closest carbonyl C contact',round(min(ds),2),'<=3.0:',[round(d,2) for d in ds if d<=3.0])\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
