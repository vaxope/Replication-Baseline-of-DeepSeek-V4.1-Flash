Sending keys: ["python3 - <<'PY'\nimport math, random\n\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef mul(a,s): return tuple(x*s for x in a)\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a):\n    n=norm(a); return tuple(x/n for x in a)\ndef dist(a,b): return norm(sub(a,b))\ndef angle(a,b,c):\n    u=sub(a,b); v=sub(c,b)\n    return math.degrees(math.acos(max(-1,min(1,dot(u,v)/(norm(u)*norm(v))))))\n\ndef coords(p):\n    a,b1,b2,y,z1,z2,z7=p\n    return {'C1':(-a,0,z1),'C4':(a,0,z1),'C7':(0,0,z7),\n            'C2':(-b1,-y,z2),'C3':(b1,-y,z2),\n            'C5':(b2,y,z2),'C6':(-b2,y,z2)}\n\nbonds=[('C1','C2',1.54),('C2','C3',1.34),('C3','C4',1.54),('C4','C5',1.54),\n       ('C5','C6',1.54),('C6','C1',1.54),('C1','C7',1.54),('C4','C7',1.54)]\nangs=[('C1','C2','C3',107),('C2','C3','C4',107),\n      ('C4','C5','C6',109.5),('C5','C6','C1',109.5),\n      ('C2','C1','C6',109.5),('C6','C1','C7',109.5),('C2','C1','C7',109.5),\n      ('C3','C4','C5',109.5),('C5','C4','C7',109.5),('C3','C4','C7',109.5),\n      ('C1','C7','C4',95)]\nnonbond=[('C1','C4',2.4,20),('C2','C6',2.7,5),('C3','C5',2.7,5),('C2','C5',2.7,5),('C3','C6',2.7,5)]\n\ndef E(p):\n    C=coords(p); e=0.0\n    for x,y,d0 in bonds:\n        e += 1000*(dist(C[x],C[y])-d0)**2\n    for x,y,z,t0 in angs:\n        e += 10*(angle(C[x],C[y],C[z])-t0)**2\n    for x,y,d0,k in nonbond:\n        d=dist(C[x],C[y])\n        if d<d0: e += k*(d-d0)**2\n    return e\n\n# gradient descent with finite differences\nbest=None; be=1e99\nfor start in range(10):\n    p=[1.15+0.1*random.random(),0.70+0.05*random.random(),0.70+0.05*random.random(),\n       1.20+0.1*random.random(),0.1+0.1*random.random(),-0.6+0.1*random.random(),1.2+0.1*random.random()]\n    e=E(p)\n    step=0.05\n    for it in range(3000):\n        g=[]\n        h=1e-4\n        for i in range(7):\n            pp=p[:]; pm=p[:]\n            pp[i]+=h; pm[i]-=h\n            g.append((E(pp)-E(pm))/(2*h))\n        gn=math.sqrt(sum(x*x for x in g))\n        if gn<1e-8: break\n        # backtracking line search\n        alpha=step/(gn+1e-12)\n        for _ in range(20):\n            q=[max(0.01,p[i]-alpha*g[i]) for i in range(7)]\n            eq=E(q)\n            if eq<e-1e-8: break\n            alpha*=0.5\n        if eq>=e: break\n        p,e=q,eq\n    if e<be: best,be=p,e\nC=coords(best)\nprint('optimized params',[round(x,4) for x in best],'E',round(be,2))\nfor k,v in C.items(): print(k,tuple(round(x,3) for x in v))\nfor x,y,d0 in bonds: print('bond',x,y,round(dist(C[x],C[y]),3))\nfor x,y,z,t0 in angs: print('angle',x,y,z,round(angle(C[x],C[y],C[z]),1),'target',t0)\n\n# local tetrahedral helper\ndef other_two_dirs(center,p1,p2):\n    u1=unit(sub(p1,center)); u2=unit(sub(p2,center))\n    s=mul(add(u1,u2),-1.0)\n    p=unit(cross(u1,u2))\n    m=math.sqrt(max(0.0,1.0-dot(s,s)/4.0))\n    d1=add(mul(s,0.5),mul(p,m)); d2=add(mul(s,0.5),mul(p,-m))\n    return unit(d1),unit(d2)\n\n# C7 hydrogens\nh7a,h7b=other_two_dirs(C['C7'],C['C1'],C['C4'])\nH7a=add(C['C7'],mul(h7a,1.09)); H7b=add(C['C7'],mul(h7b,1.09))\n# C5 substituent directions\nd5a,d5b=other_two_dirs(C['C5'],C['C4'],C['C6'])\nd5_up=d5a if d5a[2]>d5b[2] else d5b\nd5_down=d5b if d5a[2]>d5b[2] else d5a\nprint('\\nC7 H', [tuple(round(x,2) for x in H) for H in (H7a,H7b)])\nprint('C5 directions up/down', [tuple(round(x,2) for x in d) for d in (d5_up,d5_down)])\nfor mode in ('endo','exo'):\n    if mode=='endo':\n        dC,dH=d5_up,d5_down\n    else:\n        dC,dH=d5_down,d5_up\n    H5=add(C['C5'],mul(dH,1.09)); H6=(-H5[0],H5[1],H5[2])\n    print('\\n'+mode, 'H5/H6', tuple(round(x,2) for x in H5), tuple(round(x,2) for x in H6))\n    for hn,H in [('H7a',H7a),('H7b',H7b)]:\n        print(hn, 'to H5/H6:', round(dist(H,H5),2), round(dist(H,H6),2))\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
