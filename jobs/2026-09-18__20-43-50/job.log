Sending keys: ["python3 - <<'PY'\nimport math, random\n# Symmetry parameterization of norbornane carbon skeleton\n# C1(-a,0,z1), C4(a,0,z1), C7(0,0,z7)\n# C2(-b1,-y,z2), C3(b1,-y,z2), C5(b2,y,z2), C6(-b2,y,z2)\n\ndef coords(p):\n    a,b1,b2,y,z1,z2,z7=p\n    return {\n      'C1':(-a,0,z1),'C4':(a,0,z1),'C7':(0,0,z7),\n      'C2':(-b1,-y,z2),'C3':(b1,-y,z2),\n      'C5':(b2,y,z2),'C6':(-b2,y,z2),\n    }\n\ndef sub(u,v): return tuple(u[i]-v[i] for i in range(3))\ndef dot(u,v): return sum(u[i]*v[i] for i in range(3))\ndef norm(u): return math.sqrt(dot(u,u))\ndef dist(u,v): return norm(sub(u,v))\ndef ang(u,v,w):\n    a=sub(u,v); b=sub(w,v)\n    c=dot(a,b)/(norm(a)*norm(b))\n    return math.degrees(math.acos(max(-1,min(1,c))))\n\nbonds=[('C1','C2',1.54),('C2','C3',1.34),('C3','C4',1.54),\n       ('C4','C5',1.54),('C5','C6',1.54),('C6','C1',1.54),\n       ('C1','C7',1.54),('C4','C7',1.54)]\n# target angles (degrees), key rings\nangles=[('C1','C2','C3',107),('C2','C3','C4',107),\n        ('C4','C5','C6',109.5),('C5','C6','C1',109.5),\n        ('C2','C1','C6',109.5),('C6','C1','C7',109.5),('C2','C1','C7',109.5),\n        ('C3','C4','C5',109.5),('C5','C4','C7',109.5),('C3','C4','C7',109.5),\n        ('C1','C7','C4',95)]\n\np=[1.2,.67,.77,1.1,0.0,-0.2,0.9]\n\ndef energy(p):\n    C=coords(p)\n    e=0.0\n    for x,y,d0 in bonds:\n        d=dist(C[x],C[y]); e+=100*(d-d0)**2\n    for x,y,z,t0 in angles:\n        th=ang(C[x],C[y],C[z]); e+=0.15*(th-t0)**2\n    # weak nonbonded repulsion to keep cage open\n    for x,y,r0 in [('C1','C4',2.4),('C2','C6',2.7),('C3','C5',2.7),('C2','C5',2.7),('C3','C6',2.7)]:\n        d=dist(C[x],C[y])\n        if d<r0: e+=20*(r0-d)**2\n    return e\n\nbest=p[:]; be=energy(best)\nrandom.seed(1)\nfor it in range(200000):\n    q=best[:]\n    scale=0.02 if it<100000 else 0.005\n    for i in range(len(q)):\n        q[i]+=random.gauss(0,scale)\n    # keep signs/order reasonable\n    q[0]=abs(q[0]); q[1]=abs(q[1]); q[2]=abs(q[2]); q[3]=abs(q[3])\n    e=energy(q)\n    if e<be:\n        best,be=q,e\nC=coords(best)\nprint('params', [round(x,3) for x in best], 'energy', round(be,3))\nfor k,v in C.items():\n    print(k, tuple(round(x,3) for x in v))\nfor x,y,d0 in bonds:\n    print('bond',x,y,round(dist(C[x],C[y]),3))\nfor x,y,z,t0 in angles:\n    print('angle',x,y,z,round(ang(C[x],C[y],C[z]),1),'target',t0)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
