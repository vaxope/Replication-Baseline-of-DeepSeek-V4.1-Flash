Sending keys: ["python3 - <<'PY'\nimport math\n\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef add(a,b): return tuple(x+y for x,y in zip(a,b))\ndef mul(a,s): return tuple(x*s for x in a)\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef cross(a,b):\n    return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a):\n    n=norm(a)\n    return tuple(x/n for x in a)\n\nA=(-1.05,0.0,0.0)\nB=(1.05,0.0,0.0)\nC7=(0.0,0.0,1.1)\nC2=(-0.67,1.25,-0.85)\nC3=(0.67,1.25,-0.85)\nC5=(-0.77,-1.25,-0.85)\nC6=(0.77,-1.25,-0.85)\n\ndef fourth(u1,u2,u3):\n    s=add(add(unit(u1),unit(u2)),unit(u3))\n    return unit(mul(s,-1))\n\nMeA=add(A,mul(fourth(sub(C7,A),sub(C2,A),sub(C5,A)),1.50))\nMeB=add(B,mul(fourth(sub(C7,B),sub(C3,B),sub(C6,B)),1.50))\n\ndef other_two(u1,u2):\n    s=add(u1,u2)\n    ss=norm(s)\n    b=unit(s)\n    w=unit(cross(u1,u2))\n    t=math.sqrt(max(0,1-ss*ss/4))\n    d1=add(mul(b,-ss/2),mul(w,t))\n    d2=add(mul(b,-ss/2),mul(w,-t))\n    return d1,d2\n\ndef place_H_set(parent, center):\n    # place three methyl H, given center methyl carbon bonded to parent\n    u=unit(sub(parent,center))\n    # orthonormal basis perpendicular to u\n    tmp=(0,0,1) if abs(u[2])<0.9 else (1,0,0)\n    e1=unit(cross(u,tmp))\n    e2=unit(cross(u,e1))\n    th=math.radians(109.47)\n    hs=[]\n    for phi_deg in (0,120,240):\n        phi=math.radians(phi_deg)\n        d=add(mul(u,math.cos(th)),mul(add(mul(e1,math.cos(phi)),mul(e2,math.sin(phi))),math.sin(th)))\n        hs.append(add(center,mul(d,1.09)))\n    return hs\n\nH_meA=place_H_set(A,MeA)\nH_meB=place_H_set(B,MeB)\nMe2=add(C2,mul(fourth(sub(A,C2),sub(C3,C2)),1.50))\nMe3=add(C3,mul(fourth(sub(B,C3),sub(C2,C3)),1.50))\nH_me2=place_H_set(C2,Me2)\nH_me3=place_H_set(C3,Me3)\n\n# C7 bridge hydrogens\nu7A=unit(sub(A,C7)); u7B=unit(sub(B,C7))\nd7a,d7b=other_two(u7A,u7B)\nH7a=add(C7,mul(d7a,1.09)); H7b=add(C7,mul(d7b,1.09))\n\ndef place_C5_stereo(endo):\n    uA=unit(sub(A,C5)); u6=unit(sub(C6,C5))\n    du1,du2=other_two(uA,u6)\n    # choose carboxyl direction: toward C7 (higher z) for endo; away for exo\n    dC = du1 if du1[2] > du2[2] else du2\n    dH = du2 if dC is du1 else du1\n    if not endo:\n        dC,dH=dH,dC\n    H5=add(C5,mul(dH,1.09))\n    C5c=add(C5,mul(dC,1.50))\n    # mirror at x=0 for C6 (M=(-x,y,z))\n    def mirror(v): return (-v[0],v[1],v[2])\n    H6=add(C6,mirror(H5-C5))\n    return H5,H6,C5c\n\ndef all_dists(H5,H6):\n    vals={}\n    for name,Hs in [('H7a',[H7a]),('H7b',[H7b])]:\n        for hn,H in Hs:\n            vals[hn+'-H5']=norm(sub(H,H5)); vals[hn+'-H6']=norm(sub(H,H6))\n    # closest distances to methyl H sets\n    for name,Hs in [('H7a',H_meA),('H7b',H_meB),('H5',H_me2),('H6',H_me3),('H5',H_meA),('H6',H_meB)]:\n        pass\n    def min_dist(H, Hset): return min(norm(sub(H,h)) for h in Hset)\n    for hn,H in [('H7a',H7a),('H7b',H7b),('H5',H5),('H6',H6)]:\n        vals['%s-Me2'%hn]=min_dist(H,H_me2)\n        vals['%s-Me3'%hn]=min_dist(H,H_me3)\n        vals['%s-MeA'%hn]=min_dist(H,H_meA)\n        vals['%s-MeB'%hn]=min_dist(H,H_meB)\n    return vals\n\nfor endo in (True,False):\n    H5,H6,C5c=place_C5_stereo(endo)\n    print('\\n', 'ENDO' if endo else 'EXO')\n    print('C5 H z=%.2f, C6 H z=%.2f, carboxyl C z=%.2f'%(H5[2],H6[2],C5c[2]))\n    vals=all_dists(H5,H6)\n    for k in sorted(vals):\n        print(k, round(vals[k],2))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
