l(sp2_third(C2,C1,C3),1.50))\nMe3=add(C3,mul(sp2_third(C3,C4,C2),1.50))\nH_Me2=methyl_hs(C2,Me2); H_Me3=methyl_hs(C3,Me3)\n\n# C5/C6 tetrahedral directions\nd5a,d5b=other_two_dirs(C5,C1,C6)\nd5_up=d5a if d5a[2]>d5b[2] else d5b\nd5_down=d5b if d5a[2]>d5b[2] else d5a\n\nprint('C7 H positions',tuple(round(x,2) for x in H7a),tuple(round(x,2) for x in H7b))\nprint('C5 directions up/down',tuple(round(x,2) for x in d5_up),tuple(round(x,2) for x in d5_down))\n\nfor mode in ['endo','exo']:\n    if mode=='endo':\n        # anhydride toward C7 (+z), H away\n        d5C,d5H=d5_up,d5_down\n    else:\n        d5C,d5H=d5_down,d5_up\n    H5=add(C5,mul(d5H,1.09)); C5carbonyl=add(C5,mul(d5C,1.50))\n    # mirror to C6 across x=0\n    H6=(-H5[0],H5[1],H5[2])\n    print('\\n',mode,'H5/H6',tuple(round(x,2) for x in H5),tuple(round(x,2) for x in H6))\n    # closest H5/H6 to C7 H\n    dA=[dist(H7a,H5),dist(H7a,H6),dist(H7b,H5),dist(H7b,H6)]\n    print('option A bridge-H to succinic-H distances', [round(x,2) for x in dA],'min',round(min(dA),2))\n    # closest succinic H to alkene methyl hydrogens\n    dC=[dist(H5,h) for h in H_Me2+H_Me3]+[dist(H6,h) for h in H_Me2+H_Me3]\n    print('option C alkene-Me-H to succinic-H distances min',round(min(dC),2),'all<4.0',sorted(round(x,2) for x in dC if x<4.0))\n    # bridgehead methyl to bridge H\n    dB=[dist(h,H7a) for h in H_Me1+H_Me4]+[dist(h,H7b) for h in H_Me1+H_Me4]\n    print('option D bridgehead-Me-H to bridge-H min',round(min(dB),2),'all<4.0',sorted(round(x,2) for x in dB if x<4.0))\n    # bridgehead methyl to alkene methyl min\n    dD=[dist(h1,h2) for h1 in H_Me1+H_Me4 for h2 in H_Me2+H_Me3]\n    print('option B bridgehead-Me-H to alkene-Me-H min',round(min(dD),2),'all<4.0',sorted(round(x,2) for x in dD if x<4.0))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
