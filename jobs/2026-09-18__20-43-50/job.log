Sending keys: ["python3 - <<'PY'\nimport numpy as np\n\ndef sign(v1,v2,v3,v4):\n    v1=np.array(v1); v2=np.array(v2); v3=np.array(v3); v4=np.array(v4)\n    return np.dot(v1-v4, np.cross(v2-v4, v3-v4))\n\ndef rs(vals):\n    s=sign(*vals)\n    return 'S' if s>0 else 'R', s\n\n# Coordinates\nB1=np.array([-1.0,0,0])   # C4\nB2=np.array([ 1.0,0,0])   # C7\nM =np.array([ 0.0,0,1.3]) # C8\nK1=np.array([-0.6,-1,-0.4]) # C5\nK2=np.array([ 0.6,-1,-0.4]) # C6\nA1=np.array([-0.6, 1,-0.4]) # C3a\nA2=np.array([ 0.6, 1,-0.4]) # C7a\nH4=np.array([-1.0,-0.3,-0.8])\nH7=np.array([ 1.0,-0.3,-0.8])\n\nfor label, Fpos, Hm in [\n    ('F syn to anhydride side (+y)', np.array([0, 0.9, 1.6]), np.array([0,-0.9,1.6])),\n    ('F anti to anhydride side (-y)', np.array([0,-0.9, 1.6]), np.array([0, 0.9,1.6])),\n]:\n    print(label)\n    # At C4 priorities: M, A1, K1, H4\n    print(' C4:', rs([M,A1,K1,H4]))\n    # At C7 priorities: M, A2, K2, H7\n    print(' C7:', rs([M,A2,K2,H7]))\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
