Sending keys: ["python3 - <<'PY'\nimport math\n# optimized carbon skeleton from previous run\nC={\n'C1':(-1.163,0,0.194),'C4':(1.163,0,0.194),'C7':(0,0,1.297),\n'C2':(-0.713,-1.245,-0.571),'C3':(0.713,-1.245,-0.571),\n'C5':(0.748,1.245,-0.571),'C6':(-0.748,1.245,-0.571),\n}\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef mul(a,s): return tuple(x*s for x in a)\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a):\n    n=norm(a); return tuple(x/n for x in a)\ndef dist(a,b): return norm(sub(a,b))\ndef tetra4(center, bonded):\n    s=(0,0,0)\n    for p in bonded: s=add(s,unit(sub(p,center)))\n    return unit(mul(s,-1))\ndef other_two(center,p1,p2):\n    u1=unit(sub(p1,center)); u2=unit(sub(p2,center))\n    s=mul(add(u1,u2),-1.0); p=unit(cross(u1,u2))\n    m=math.sqrt(max(0,1-dot(s,s)/4))\n    d1=add(mul(s,.5),mul(p,m)); d2=add(mul(s,.5),mul(p,-m))\n    return unit(d1),unit(d2)\ndef methyl_Hs(parent,Cme):\n    u=unit(sub(parent,Cme))\n    ref=(0,0,1) if abs(dot(u,(0,0,1)))<0.9 else (1,0,0)\n    e1=unit(cross(u,ref)); e2=unit(cross(u,e1))\n    th=math.radians(109.47); out=[]\n    for phi in (0,120,240):\n        r=math.radians(phi)\n        d=add(mul(u,math.cos(th)),mul(add(mul(e1,math.cos(r)),mul(e2,math.sin(r))),math.sin(th)))\n        out.append(add(Cme,mul(d,1.09)))\n    return out\n# methyl carbons\nMe1=add(C['C1'],mul(tetra4(C['C1'],[C['C2'],C['C6'],C['C7']]),1.5))\nMe4=add(C['C4'],mul(tetra4(C['C4'],[C['C3'],C['C5'],C['C7']]),1.5))\ndef sp2_third(center,p1,p2): return unit(mul(add(unit(sub(p1,center)),unit(sub(p2,center))),-1))\nMe2=add(C['C2'],mul(sp2_third(C['C2'],C['C1'],C['C3']),1.5))\nMe3=add(C['C3'],mul(sp2_third(C['C3'],C['C4'],C['C2']),1.5))\nH_Me1=methyl_Hs(C['C1'],Me1); H_Me4=methyl_Hs(C['C4'],Me4)\nH_Me2=methyl_Hs(C['C2'],Me2); H_Me3=methyl_Hs(C['C3'],Me3)\n# bridge H\nd7a,d7b=other_two(C['C7'],C['C1'],C['C4'])\nH7a=add(C['C7'],mul(d7a,1.09)); H7b=add(C['C7'],mul(d7b,1.09))\n# succinic H for endo (anhydride toward C7, H away) and exo (H toward C7)\nd5a,d5b=other_two(C['C5'],C['C4'],C['C6'])\nd5_up=d5a if d5a[2]>d5b[2] else d5b\nd5_down=d5b if d5a[2]>d5b[2] else d5a\nfor mode in ('endo','exo'):\n    dC,dH=(d5_up,d5_down) if mode=='endo' else (d5_down,d5_up)\n    H5=add(C['C5'],mul(dH,1.09)); H6=(-H5[0],H5[1],H5[2])\n    succ=[H5,H6]\n    bridge=[H7a,H7b]\n    m1=H_Me1+H_Me4 # bridgehead methyl H\n    m2=H_Me2+H_Me3 # alkene methyl H\n    def min_d(A,B): return min(dist(a,b) for a in A for b in B)\n    print('\\n'+mode)\n    print('A bridge-H (1H ~1.5) to succinic-H (2H ~3.5): %.2f'%min_d(bridge,succ))\n    print('B bridgehead-Me (6H ~1.0) to alkene-Me (6H ~1.7): %.2f'%min_d(m1,m2))\n    print('C alkene-Me (6H ~1.7) to succinic-H (2H ~3.5): %.2f'%min_d(m2,succ))\n    print('D bridgehead-Me (6H ~1.0) to bridge-H (1H ~1.5): %.2f'%min_d(m1,bridge))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
