Sending keys: ["python3 - <<'PY'\nimport math\n\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(*vs): return tuple(sum(v[i] for v in vs) for i in range(3))\ndef scale(s,v): return tuple(s*x for x in v)\ndef norm(v):\n    n=math.sqrt(sum(x*x for x in v)); return tuple(x/n for x in v)\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef det3(a,b,c): return dot(a,cross(b,c))\n\ndef labels(center, p1,p2,p3,p4):\n    # directions from center to priorities 1,2,3,4\n    d1=norm(sub(p1,center)); d2=norm(sub(p2,center)); d3=norm(sub(p3,center))\n    t=det3(d1,d2,d3)\n    return 'R' if t<0 else 'S', t\n\n# Approximate norbornene-like cage. Bridgeheads A=C4, B=C7; sulfur bridge S;\n# P=C3a, Q=C7a (maleic-derived, bearing anhydride); U=C5, V=C6 (alkene bridge)\nA=(0,0,1.0)\nB=(0,0,-1.0)\nS=(0,1.0,0)\nP=(1.0,-0.6,0.5)\nQ=(1.0,-0.6,-0.5)\nU=(-1.0,-0.6,0.5)\nV=(-1.0,-0.6,-0.5)\nMeA=(0,-1.0,0.6)  # rough direction for methyl at A\nMeB=(0,-1.0,-0.6) # rough direction for methyl at B\n\ndef analyze(name, cy, oz):\n    # cy: y-coordinate of carbonyl carbons; oz: z-offset of carbonyls\n    # endo: cy > 0 (toward S), exo: cy < 0 (away from S)\n    C1c=(1.0, cy, 0.9)\n    C3c=(1.0, cy, -0.9)\n    # H directions, for chirality only use opposite sum of three heavy substituents\n    def Hpos(center, others):\n        return norm(scale(-1, add(*[sub(x,center) for x in others])))\n\n    # At A: priorities 1=S, 2=P, 3=U, 4=Me\n    HA=Hpos(A,[S,P,U])\n    # At B: priorities 1=S, 2=Q, 3=V, 4=Me\n    HB=Hpos(B,[S,Q,V])\n    # At P=C3a: priorities 1=A, 2=C1c, 3=Q, 4=H\n    HP=Hpos(P,[A,C1c,Q])\n    # At Q=C7a: priorities 1=B, 2=C3c, 3=P, 4=H\n    HQ=Hpos(Q,[B,C3c,P])\n\n    lpA,tA=labels(A,S,P,U,MeA)\n    lpB,tB=labels(B,S,Q,V,MeB)\n    lpP,tP=labels(P,A,C1c,Q,HP)\n    lpQ,tQ=labels(Q,B,C3c,P,HQ)\n    print(name, ': A/C4', lpA, 'B/C7', lpB, 'P/C3a', lpP, 'Q/C7a', lpQ)\n\nanalyze('endo (anhydride syn to S)', 0.6, 0.4)\nanalyze('exo  (anhydride anti to S)', -1.8, 0.4)\nPY\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
