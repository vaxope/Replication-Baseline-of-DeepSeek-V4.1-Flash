Sending keys: ["cat > /tmp/geom.py <<'PY'\nimport numpy as np, itertools, math\n\n# ideal chair with alternating z\nd = 1/(4*math.sqrt(2))\ns3 = math.sqrt(3)/2\nC = np.array([\n    [1, 0, d],\n    [0.5, s3, -d],\n    [-0.5, s3, d],\n    [-1, 0, -d],\n    [-0.5, -s3, d],\n    [0.5, -s3, -d]\n], float)\n\n# return unit vectors from atom i to its two ring neighbors\nnbrs = {i:((i-1)%6,(i+1)%6) for i in range(6)}\nringdirs = {}\nfor i,(a,b) in nbrs.items():\n    u = C[a]-C[i]; v = C[b]-C[i]\n    u /= np.linalg.norm(u); v /= np.linalg.norm(v)\n    m = u+v; m /= np.linalg.norm(m)\n    n = np.cross(u,v); n /= np.linalg.norm(n)\n    w1 = -m/math.sqrt(3) + math.sqrt(2/3)*n\n    w2 = -m/math.sqrt(3) - math.sqrt(2/3)*n\n    # axial is the one with larger absolute z component\n    if abs(w1[2]) > abs(w2[2]): ax,eq = w1,w2\n    else: ax,eq = w2,w1\n    ringdirs[i] = (u,v,ax,eq)\n    print('C%d'%(i+1), 'ax', np.round(ax,4), 'eq', np.round(eq,4), 'z(ax)=%.3f z(eq)=%.3f'%(ax[2],eq[2]))\n\ndef chirality(center, bonds, prio):\n    # bonds: list of 4 vectors; prio: list of indices in priority order 1,2,3,4\n    v1,v2,v3,v4 = [bonds[p] for p in prio]\n    # All vectors point from center to ligand. Det sign calibration: negative R, positive S\n    D = np.linalg.det(np.column_stack([v1,v2,v3]))\n    return ('R' if D < 0 else 'S'), D\n\n# First find which C4 heavy substituent orientation gives R\nprint('\\nC4 configs (priority iPr, C3, C5, H):')\nfor choice in [0,1]:\n    i=3\n    u,v,ax,eq = ringdirs[i]\n    heavy = ax if choice==0 else eq\n    h = eq if choice==0 else ax\n    # priorities: iPr=0, C3=u, C5=v, H=1; assign indices [0,1,2,3]\n    bonds = [heavy, u, v, h]\n    conf,D = chirality(C, bonds, [0,1,2,3])\n    print('iPr along', 'ax' if choice==0 else 'eq', conf, 'det=%.4f'%D)\n\n# Enumerate C1 and C2 oxygen placements, holding C4 R (iPr axial or eq)\n# For C1: priority O, C2, C6, CH3. Ring neighbors from C1 are C2 and C6.\n# For C2: priority O, C1, C3, H. Ring neighbors C1 and C3.\n# Use fixed C4 iPr orientation (choice found above), then enumerate O orientations.\nprint('\\nC1/C2 oxygen orientation combos:')\nfor c4choice in [0,1]:\n    for c1choice in [0,1]:   # O on ax or eq (CH3 opposite)\n        for c2choice in [0,1]:  # OMe heavy on ax or eq (H opposite)\n            i4=3; u4,v4,ax4,eq4 = ringdirs[i4]\n            ipr = ax4 if c4choice==0 else eq4\n            h4  = eq4 if c4choice==0 else ax4\n            conf4,D4 = chirality(C,[ipr,u4,v4,h4],[0,1,2,3])\n            if conf4 != 'R':\n                continue\n            # C1 index 0, neighbors C2(index1) and C6(index5)\n            i1=0; u1,v1,ax1,eq1 = ringdirs[i1]\n            O1 = ax1 if c1choice==0 else eq1\n            CH3 = eq1 if c1choice==0 else ax1\n            # priorities O=0, C2=1, C6=2, CH3=3\n            conf1,D1 = chirality(C,[O1,u1,v1,CH3],[0,1,2,3])\n            # C2 index 1, neighbors C1(index0) and C3(index2)\n            i2=1; u2,v2,ax2,eq2 = ringdirs[i2]\n            O2 = ax2 if c2choice==0 else eq2\n            H2 = eq2 if c2choice==0 else ax2\n            # priorities O=0, C1=1, C3=2, H=3\n            conf2,D2 = chirality(C,[O2,u2,v2,H2],[0,1,2,3])\n            print('c4=%s c1_O=%s c2_O=%s => C4 %s C1 %s C2 %s'%(\n                'ax' if c4choice==0 else 'eq', 'ax' if c1choice==0 else 'eq',\n                'ax' if c2choice==0 else 'eq', conf4, conf1, conf2))\nPY\npython3 /tmp/geom.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
