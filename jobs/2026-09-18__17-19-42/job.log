Sending keys: ["python3 <<'PY'\nimport math\n\ndef sub(a,b): return (a[0]-b[0], a[1]-b[1], a[2]-b[2])\ndef add(a,b): return (a[0]+b[0], a[1]+b[1], a[2]+b[2])\ndef mul(a,s): return (a[0]*s, a[1]*s, a[2]*s)\ndef dot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef unit(a):\n    n=math.sqrt(dot(a,a)); return (a[0]/n,a[1]/n,a[2]/n)\ndef rs(c, prio):\n    v=[sub(x,c) for x in prio]\n    vol=dot(cross(sub(v[0],v[3]), sub(v[1],v[3])), sub(v[2],v[3]))\n    return 'S' if vol>0 else 'R'\n\n# idealized norbornane coordinates\nA=(-0.99,0.0,0.0)   # C4\nB=(0.99,0.0,0.0)    # C7\nG=(0.0,0.0,1.18)    # S bridge\nC=(-0.77,1.257,-0.862) # C3a\nD=(0.77,1.257,-0.862)  # C7a\nE=(-0.77,-1.257,-0.862) # C5\nF=(0.77,-1.257,-0.862) # C6\n\n# tetrahedral remaining directions at C and D, two choices\nuC_A=unit(sub(A,C)); uC_D=unit(sub(D,C))\nuD_B=unit(sub(B,D)); uD_C=unit(sub(C,D))\n\n# Solve equal-dot directions x: x.uA=x.uD=-1/3, unit, chooses two z values.\ndef missing_dirs(u1,u2):\n    # brute force angular scan on unit sphere and select best score\n    best=[]\n    for i in range(200):\n        th=math.pi*i/199\n        for j in range(400):\n            ph=2*math.pi*j/399\n            x=(math.sin(th)*math.cos(ph), math.sin(th)*math.sin(ph), math.cos(th))\n            score=abs(dot(x,u1)+1/3)+abs(dot(x,u2)+1/3)\n            best.append((score,x))\n    best.sort(key=lambda t:t[0])\n    # pick two distinct directions, one with max z and one with min z\n    cand=[x for s,x in best if s<0.02]\n    return max(cand,key=lambda x:x[2]), min(cand,key=lambda x:x[2])\n\nx_exo_C,x_endo_C=missing_dirs(uC_A,uC_D)\nx_exo_D,x_endo_D=missing_dirs(uD_B,uD_C)\nprint('dirs C exo/endo',x_exo_C,x_endo_C)\nprint('dirs D exo/endo',x_exo_D,x_endo_D)\n\n# methyl directions at A and B, opposite sum of other three bonds\nm_A=mul(unit(add(add(unit(sub(G,A)),unit(sub(C,A))),unit(sub(E,A)))),-1)\nm_B=mul(unit(add(add(unit(sub(G,B)),unit(sub(D,B))),unit(sub(F,B)))),-1)\n\nfor mode in ['exo','endo']:\n    xC = x_exo_C if mode=='exo' else x_endo_C\n    xD = x_exo_D if mode=='exo' else x_endo_D\n    C1=add(C,mul(xC,1.5))  # carbonyl carbon at C3a\n    C3=add(D,mul(xD,1.5))  # carbonyl carbon at C7a\n    # H at opposite missing direction\n    hC = sub(mul(add(uC_A,uC_D),-1), xC)\n    hD = sub(mul(add(uD_B,uD_C),-1), xD)\n    H_C=add(C,hC); H_D=add(D,hD)\n    # CIP priorities (based on substituent atom types)\n    c3a_prio=[A,C1,D,H_C]\n    c7a_prio=[B,C3,C,H_D]\n    c4_prio=[G,C,E,add(A,mul(m_A,1.5))]\n    c7_prio=[G,D,F,add(B,mul(m_B,1.5))]\n    labels=(rs(C,c3a_prio),rs(D,c7a_prio),rs(A,c4_prio),rs(B,c7_prio))\n    print(mode,'C3a,C7a,C4,C7 =',labels)\nPY\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
