n    g=[]\n    for i in range(len(x)):\n        xp=x[:]; xm=x[:]\n        xp[i]+=h; xm[i]-=h\n        g.append((energy(xp)-energy(xm))/(2*h))\n    gn=math.sqrt(sum(v*v for v in g))\n    if gn<1e-8: break\n    improved=False\n    step=lr\n    for _ in range(30):\n        xt=[x[i]-step*g[i] for i in range(len(x))]\n        et=energy(xt)\n        if et<best:\n            x=xt; best=et; improved=True; lr=min(0.01,lr*1.1); break\n        step*=0.5\n    if not improved:\n        lr*=0.5\n        if lr<1e-9: break\nprint('best E',best)\ncoords=[x[3*i:3*i+3] for i in range(7)]\nfor i,c in enumerate(coords): print(i,tuple(round(v,3) for v in c))\nfor i,j,r0 in bonds:\n    print('bond',i,j,round(norm(sub(coords[i],coords[j])),3))\nprint('alkene torr',math.degrees(torsion_angle(coords[0],coords[3],coords[4],coords[1])))\nfor a,b,c,th0 in angles:\n    u=sub(coords[a],coords[b]); v=sub(coords[c],coords[b])\n    th=math.degrees(math.acos(max(-1,min(1,dot(u,v)/(norm(u)*norm(v))))))\n    print('angle',a,b,c,round(th,1))\nPY\npython3 /tmp/opt_norbornene.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
