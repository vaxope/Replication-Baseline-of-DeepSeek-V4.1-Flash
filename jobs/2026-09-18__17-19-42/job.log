Sending keys: ["python3 - <<'PY'\nimport math\n# optimized norbornane heavy atoms\nC1=(0.096,0.0,1.143)\nC4=(0.096,0.0,-1.143)\nC7=(1.128,0.0,0.0)\nC2=(-0.768,1.219,0.77)\nC3=(-0.768,1.219,-0.77)\nC6=(-0.768,-1.219,0.77)\nC5=(-0.768,-1.219,-0.77)\n\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef mul(a,s): return tuple(a[i]*s for i in range(3))\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a):\n    n=norm(a); return tuple(x/n for x in a)\n\ndef tetra_dirs(u1,u2):\n    u1=unit(u1); u2=unit(u2)\n    S=unit(add(u1,u2)); cs=dot(u1,S); ca=-1/3\n    x=ca/cs\n    p=unit(cross(u1,u2)); q=math.sqrt(max(0,1-x*x))\n    return add(mul(S,x),mul(p,q)), add(mul(S,x),mul(p,-q))\n\n# C7 hydrogens\nh7dirs=tetra_dirs(sub(C1,C7),sub(C4,C7))\nH7=[add(C7,mul(d,1.10)) for d in h7dirs]\nprint('H7',H7)\nfor atom,base,nbrs,ref in [('C5',C5,(C4,C6),C7),('C6',C6,(C1,C5),C7)]:\n    ds=tetra_dirs(sub(nbrs[0],base),sub(nbrs[1],base))\n    refdir=unit(sub(ref,base))\n    print('\\n',atom,'dirs:')\n    for i,d in enumerate(ds):\n        # H is opposite d if d is anhydride carbon direction\n        H=add(base,mul(mul(d,-1),1.10))\n        Ccarbonyl=add(base,mul(d,1.50))\n        print(' dir',i,'dot toward C7',round(dot(d,refdir),3),'Ccarbonyl-C7 dist',round(norm(sub(Ccarbonyl,ref)),2),'H-H7',[round(norm(sub(H,h)),2) for h in H7])\n\n# methyl H approximations\n# bridgehead C1/C4 methyl C directions opposite sum of three heavy bonds\nfor label,C in [('C1',C1),('C4',C4)]:\n    nbrs = [C2,C6,C7] if label=='C1' else [C3,C5,C7]\n    v=unit(mul(add(add(unit(sub(nbrs[0],C)),unit(sub(nbrs[1],C))),unit(sub(nbrs[2],C))),-1))\n    Cme=add(C,mul(v,1.50))\n    # approximate methyl H positions from arbitrary perpendicular frame\n    axis=unit(sub(Cme,C))\n    trial=(0,0,1) if abs(dot(axis,(0,0,1)))<0.9 else (0,1,0)\n    p=unit(sub(trial,mul(axis,dot(trial,axis))))\n    q=unit(cross(axis,p))\n    ct=math.cos(math.radians(109.5)); st=math.sin(math.radians(109.5))\n    hs=[]\n    for k in range(3):\n        psi=2*math.pi*k/3\n        hd=add(mul(axis,-ct),add(mul(p,st*math.cos(psi)),mul(q,st*math.sin(psi))))\n        hs.append(add(Cme,mul(hd,1.09)))\n    print('\\n',label,'methyl H positions',hs)\n\n# alkene C2/C3 methyl carbons: sp2 carbon with bonds to C1 (or C4), other alkene C, and methyl\nfor label,C,base in [('C2',C2,C1),('C3',C3,C4)]:\n    other = C3 if label=='C2' else C2\n    v=unit(mul(add(unit(sub(base,C)),unit(sub(other,C))),-1))\n    Cme=add(C,mul(v,1.50))\n    axis=unit(sub(Cme,C))\n    trial=(0,0,1) if abs(dot(axis,(0,0,1)))<0.9 else (0,1,0)\n    p=unit(sub(trial,mul(axis,dot(trial,axis))))\n    q=unit(cross(axis,p))\n    ct=math.cos(math.radians(109.5)); st=math.sin(math.radians(109.5))\n    hs=[]\n    for k in range(3):\n        psi=2*math.pi*k/3\n        hd=add(mul(axis,-ct),add(mul(p,st*math.cos(psi)),mul(q,st*math.sin(psi))))\n        hs.append(add(Cme,mul(hd,1.09)))\n    print('\\n',label,'methyl H positions',hs)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
