Sending keys: ["cat > /tmp/opt_norbornane.py <<'PY'\nimport math, random\n\n# Atom indices: 0 C1, 1 C4, 2 C7, 3 C2, 4 C3, 5 C6, 6 C5\n# Connectivity: C1-C2, C2-C3, C3-C4, C4-C5, C5-C6, C6-C1, C1-C7, C4-C7\nbonds=[(0,3),(3,4),(4,1),(1,6),(6,5),(5,0),(0,2),(1,2)]\n# heavy-atom angles: each sp3 carbon has 3 angles; C7 also two H but heavy angle only C1-C7-C4\nangles=[]\nfor center, nbrs in [(0,[3,5,2]),(1,[4,6,2]),(3,[0,4]),(4,[3,1]),(5,[6,0]),(6,[1,5]),(2,[0,1])]:\n    for i in range(len(nbrs)):\n        for j in range(i+1,len(nbrs)):\n            angles.append((nbrs[i],center,nbrs[j]))\n\nr0=1.54\nth0=math.radians(109.47)\nkb=200.0\nka=1.0\n\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef mul(a,s): return tuple(a[i]*s for i in range(3))\ndef norm(a): return math.sqrt(dot(a,a))\n\ndef energy(x):\n    coords=[tuple(x[3*i:3*i+3]) for i in range(7)]\n    E=0.0\n    for i,j in bonds:\n        d=norm(sub(coords[i],coords[j]))\n        E += kb*(d-r0)**2\n    for a,b,c in angles:\n        u=sub(coords[a],coords[b]); v=sub(coords[c],coords[b])\n        cosang=dot(u,v)/(norm(u)*norm(v))\n        cosang=max(-1,min(1,cosang))\n        th=math.acos(cosang)\n        E += ka*(th-th0)**2\n    return E\n\n# initial guess\ncoords=[\n (0.0,0.0,1.15),   # C1\n (0.0,0.0,-1.15),  # C4\n (1.25,0.0,0.0),   # C7\n (-0.75,0.95,0.95),# C2\n (-0.75,0.95,-0.95),# C3\n (-0.75,-0.95,0.95),# C6\n (-0.75,-0.95,-0.95) # C5\n]\nx=[v for c in coords for v in c]\nh=1e-4\nlr=0.005\nbest=energy(x); bestx=x[:]\nprint('start E',best)\nfor it in range(20000):\n    # finite-diff gradient\n    g=[0.0]*len(x)\n    for i in range(len(x)):\n        xp=x[:]; xm=x[:]\n        xp[i]+=h; xm[i]-=h\n        g[i]=(energy(xp)-energy(xm))/(2*h)\n    gn=math.sqrt(sum(v*v for v in g))\n    if gn<1e-7:\n        break\n    # line search\n    step=lr\n    improved=False\n    for _ in range(30):\n        xt=[x[i]-step*g[i] for i in range(len(x))]\n        et=energy(xt)\n        if et<best:\n            x=xt; best=et; bestx=x[:]\n            improved=True\n            lr=min(0.02, lr*1.05)\n            break\n        step*=0.5\n    if not improved:\n        lr*=0.5\n        if lr<1e-8:\n            break\n    if it%2000==0:\n        print(it, best, 'gn',gn,'lr',lr)\n\nprint('final E',best,'lr',lr)\ncoords=[bestx[3*i:3*i+3] for i in range(7)]\nfor i,c in enumerate(coords): print(i, tuple(round(v,3) for v in c))\nfor i,j in bonds:\n    d=norm(sub(coords[i],coords[j])); print('bond',i,j,round(d,3))\n# print selected angles\nfor a,b,c in angles:\n    u=sub(coords[a],coords[b]); v=sub(coords[c],coords[b])\n    ang=math.degrees(math.acos(max(-1,min(1,dot(u,v)/(norm(u)*norm(v))))))\n    print('angle',a,b,c,round(ang,1))\nPY\npython3 /tmp/opt_norbornane.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
