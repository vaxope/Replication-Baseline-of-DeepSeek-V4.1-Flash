Sending keys: ["python3 - <<'PY'\nimport math\n\n# approximate norbornene framework coordinates (not unique but captures topology)\nC1=(-1.15,0,0)\nC4=(1.15,0,0)\nC7=(0,0,1.02)\nC2=(-0.77,1.2,-0.887)\nC3=(0.77,1.2,-0.887)\nC5=(0.77,-1.2,-0.887)\nC6=(-0.77,-1.2,-0.887)\n\ndef sub(a,b): return tuple(a[i]-b[i] for i in range(3))\ndef add(a,b): return tuple(a[i]+b[i] for i in range(3))\ndef mul(a,s): return tuple(a[i]*s for i in range(3))\ndef dot(a,b): return sum(a[i]*b[i] for i in range(3))\ndef norm(a): return math.sqrt(dot(a,a))\ndef unit(a):\n    n=norm(a); return tuple(x/n for x in a)\ndef scale_to(a,L):\n    u=unit(a); return mul(u,L)\n\n# known bond unit vectors at C5 from C5 to C4 and C6\nv54=unit(sub(C4,C5))\nv56=unit(sub(C6,C5))\ns=mul(add(v54,v56),-1)\nS=unit(s)\n# normal to C4-C5-C6 plane\nn=unit((0,-1.366,1.848))  # from cross product below\n# remaining tetrahedral directions are cos(phi)*S +/- sin(phi)*n\n# where |S| = 2 cos(phi), here |s| computed below\nabs_s=norm(s)\ncosphi=abs_s/2.0\nsinphi=math.sqrt(max(0,1-cosphi*cosphi))\nl_away=add(mul(S,cosphi),mul(n,sinphi))\nl_toward=add(mul(S,cosphi),mul(n,-sinphi))\n# l_away points toward C7 side (away from C2/C3); l_toward points toward C2/C3\nprint('|s|',abs_s,'cosphi',cosphi)\nprint('C5 directions away/toward:',l_away,l_toward)\n\n# C7 H directions\nv71=unit(sub(C1,C7)); v74=unit(sub(C4,C7))\ns7=mul(add(v71,v74),-1)\nS7=unit(s7)\nn7=unit((0,-1,0))\nabs_s7=norm(s7); c7=abs_s7/2; s7v=math.sqrt(max(0,1-c7*c7))\nH7a=add(mul(S7,c7),mul(n7,s7v))\nH7b=add(mul(S7,c7),mul(n7,-s7v))\nprint('C7 H dirs',H7a,H7b)\n\n# C2 methyl carbon direction: trigonal sp2, opposite sum of bonds to C1 and C3\nu21=unit(sub(C1,C2)); u23=unit(sub(C3,C2))\nd2=unit(mul(add(u21,u23),-1))\nC2Me=add(C2,mul(d2,1.50))\nu31=unit(sub(C4,C3)); u32=unit(sub(C2,C3))\nd3=unit(mul(add(u31,u32),-1))\nC3Me=add(C3,mul(d3,1.50))\nprint('methyl C positions',C2Me,C3Me)\n\n# Generate methyl hydrogens tetrahedrally around each methyl carbon.\n# The Cmethyl->parent bond direction is -d; build one perpendicular and rotate.\ndef methyl_h_positions(Cme, parent_dir, rCH=1.09):\n    # parent_dir is unit vector from parent atom to methyl carbon; H directions make tetra angle\n    axis=unit(parent_dir)\n    # find a unit vector perpendicular to axis\n    trial=(0,0,1)\n    if abs(dot(axis,trial))>0.9: trial=(0,1,0)\n    perp=unit(sub(trial,mul(axis,dot(trial,axis))))\n    # H directions from methyl carbon: angle with C-C bond is 109.5, so component along -axis\n    comp=math.cos(math.radians(109.5))  # along axis? The H directions relative to parent bond\n    # Actually angle between Cme->H and Cme->parent is 109.5. parent dir from Cme = -axis\n    # Solve h = cos(theta)*(-axis) + sin(theta)*(cos psi perp + sin psi perp2)\n    # theta = 109.5 relative to Cme->parent = -axis\n    cos_t=math.cos(math.radians(109.5))\n    sin_t=math.sin(math.radians(109.5))\n    perp2=unit((axis[1]*perp[2]-axis[2]*perp[1], axis[2]*perp[0]-axis[0]*perp[2], axis[0]*perp[1]-axis[1]*perp[0]))\n    hs=[]\n    for k in range(3):\n        psi=2*math.pi*k/3\n        hdir=add(mul(mul(axis,-1),cos_t), add(mul(perp,sin_t*math.cos(psi)),mul(perp2,sin_t*math.sin(psi))))\n        hs.append(add(Cme,mul(hdir,rCH)))\n    return hs\n\nH2= methyl_h_positions(C2Me,d2)\nH3= methyl_h_positions(C3Me,d3)\n\n# anhydride CH positions at C5/C6 for endo (H away) and exo (H toward)\nH5_endo=add(C5,mul(l_away,1.10))\nH5_exo=add(C5,mul(l_toward,1.10))\nH6_endo=add(C6,mul(unit(sub(C1,C6)),1.10))  # placeholder not used\n\n# C7 H positions (bond length 1.10)\nH7a_p=add(C7,mul(H7a,1.10)); H7b_p=add(C7,mul(H7b,1.10))\n\ndef d(a,b): return norm(sub(a,b))\nprint('\\nEndo H5 to C7-H distances:',d(H5_endo,H7a_p),d(H5_endo,H7b_p))\nprint('Exo  H5 to C7-H distances:',d(H5_exo,H7a_p),d(H5_exo,H7b_p))\nfor label,hs in [('C2Me',H2),('C3Me',H3)]:\n    print('\\n',label,'to H5_endo distances:',[round(d(H5_endo,h),2) for h in hs])\n    print(label,'to H5_exo distances:',[round(d(H5_exo,h),2) 