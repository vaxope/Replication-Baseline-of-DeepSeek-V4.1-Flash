Sending keys: ["python3 - <<'EOF'\nimport numpy as np\n\ndef rs(center, ligands):\n    # ligands: list of (name, coords, priority 1-4)\n    # CIP: view with priority 4 pointing away, 1->2->3 clockwise = R\n    c = np.array(center, float)\n    d = {}\n    for name, xyz, p in ligands:\n        v = np.array(xyz,float)-c\n        d[p] = v/np.linalg.norm(v)\n    # sign of scalar triple product d1 . (d2 x d3)\n    # if d4 points away (negative viewing direction), positive triple = clockwise? We'll test with simple known.\n    s = np.dot(d[1], np.cross(d[2], d[3]))\n    # For a standard tetrahedron, this sign gives one configuration; map sign to R/S based on test below.\n    return 'R' if s < 0 else 'S', s\n\ndef norm(v):\n    v=np.array(v,float); return v/np.linalg.norm(v)\n\n# approximate cage coords\nB1=np.array([-1.4,0,0.0]) # C4\nB2=np.array([ 1.4,0,0.0]) # C7\nE1=np.array([-0.7,1.2,0.0]) # C5\nE2=np.array([ 0.7,1.2,0.0]) # C6\nA1=np.array([-0.7,-1.2,0.0]) # C3a\nA2=np.array([ 0.7,-1.2,0.0]) # C7a\nC8=np.array([0,0,1.4])\n\n# carbonyls: endo = same side as C8 (+z)\nCA=np.array([A1[0]-0.3,A1[1]-0.5,A1[2]+1.2]) # carbonyl C attached to A1\nCB=np.array([A2[0]+0.3,A2[1]-0.5,A2[2]+1.2])\n# A-H: exo (-z)\nHA1=np.array([A1[0]-0.3,A1[1]-0.3,A1[2]-1.0])\nHA2=np.array([A2[0]+0.3,A2[1]-0.3,A2[2]-1.0])\n\ndef opposite_sum(v, scale=1.0):\n    v=np.array(v)\n    return -v/np.linalg.norm(v)*scale\n\n# H on B1/B2\nHB1=B1+opposite_sum((A1-B1)+(E1-B1)+(C8-B1),1.0)\nHB2=B2+opposite_sum((A2-B2)+(E2-B2)+(C8-B2),1.0)\n\n# C8 substituent positions: directions toward A side (-y,+z) and E side (+y,+z)\nF_endo = C8 + norm([0,-1.0,1.0])*1.1\nF_exo  = C8 + norm([0, 1.0,1.0])*1.1\nH_anti = C8 + norm([0, 1.0,1.0])*1.0   # opposite F if F endo\nH_endo = C8 + norm([0,-1.0,1.0])*1.0\n\n# first test chirality on a known simple center to calibrate sign\n# Tetrahedral center at origin with priorities 1=(1,0,0),2=(0,1,0),3=(0,0,1),4=(-1,-1,-1)\ncal=rs([0,0,0],[('1',[1,0,0],1),('2',[0,1,0],2),('3',[0,0,1],3),('4',[-1,-1,-1],4)])\nprint('calibration',cal)\n\n# Descriptor calculations with assumed priority ranks\n# core centers\nprint('B1/C4 core', rs(B1,[('C8',C8,1),('A1',A1,2),('E1',E1,3),('H',HB1,4)]))\nprint('B2/C7 core', rs(B2,[('C8',C8,1),('A2',A2,2),('E2',E2,3),('H',HB2,4)]))\nprint('A1/C3a core', rs(A1,[('CA',CA,1),('A2',A2,2),('B1',B1,3),('H',HA1,4)]))\nprint('A2/C7a core', rs(A2,[('CB',CB,1),('A1',A1,2),('B2',B2,3),('H',HA2,4)]))\n\n# C8 with F endo, and priorities B2(R) > B1(S) if core B1 S/B2 R; try both orders\nprint('C8 F syn/anhydride, order B2=2,B1=3', rs(C8,[('F',F_endo,1),('B2',B2,2),('B1',B1,3),('H',H_anti,4)]))\nprint('C8 F anti/anhydride, order B2=2,B1=3', rs(C8,[('F',F_exo,1),('B2',B2,2),('B1',B1,3),('H',H_endo,4)]))\nprint('C8 F syn/anhydride, order B1=2,B2=3', rs(C8,[('F',F_endo,1),('B1',B1,2),('B2',B2,3),('H',H_anti,4)]))\nprint('C8 F anti/anhydride, order B1=2,B2=3', rs(C8,[('F',F_exo,1),('B1',B1,2),('B2',B2,3),('H',H_endo,4)]))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
