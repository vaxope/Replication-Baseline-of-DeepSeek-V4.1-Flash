':C3,'C4':C4,'C5':C5,'C6':C6,'C7':C7}\nfor i in ['C1','C2','C3','C4','C5','C6','C7']:\n  for j in ['C1','C2','C3','C4','C5','C6','C7']:\n    if i<j:\n      dd=norm(sub(names[i],names[j]))\n      if dd<1.8: print('bond',i,j,round(dd,3))\nprint('C1-C4',norm(sub(C1,C4)))\n\n# C7 hydrogens: C7 bonds to C1,C4 and two H using tetra geometry\nC7_dirs=tetra_dirs(sub(C1,C7),sub(C4,C7))\nH7=[add(C7,mul(d,1.10)) for d in C7_dirs]\n# choose H7 labels by z maybe; print\nprint('C7-H positions',H7)\n\n# C2 methyl carbon\nmc2=unit(mul(add(unit(sub(C1,C2)),unit(sub(C3,C2))),-1))\nC2Me=add(C2,mul(mc2,1.50))\n# C3 methyl carbon\nmc3=unit(mul(add(unit(sub(C4,C3)),unit(sub(C2,C3))),-1))\nC3Me=add(C3,mul(mc3,1.50))\n# C1 methyl carbon from three neighbors C2,C6,C7\nmc1=unit(mul(add(add(unit(sub(C2,C1)),unit(sub(C6,C1))),unit(sub(C7,C1))),-1))\nC1Me=add(C1,mul(mc1,1.50))\nmc4=unit(mul(add(add(unit(sub(C3,C4)),unit(sub(C5,C4))),unit(sub(C7,C4))),-1))\nC4Me=add(C4,mul(mc4,1.50))\n\n# C5 directions: neighbors C4,C6; two remaining dirs are H and C8\nv54=sub(C4,C5); v56=sub(C6,C5)\nd5a,d5b=tetra_dirs(v54,v56)\n# C6 directions: neighbors C1,C5\nv61=sub(C1,C6); v65=sub(C5,C6)\nd6a,d6b=tetra_dirs(v61,v65)\n\ndef choose_toward(dirs, ref):\n    return max(dirs, key=lambda d: dot(d,unit(sub(ref, C5 if len(dirs)==2 and False else (0,0,0)))))\n# identify which C5 dirs point toward C7; both C5/C6 use their own atom as base for ref, but dot direction with ref direction enough\ndef closer_to(ref_atom, atom, d):\n    return dot(d, unit(sub(ref_atom,atom)))\nfor labels, di in [('C5',d5a),('C5',d5b)]: print(labels,'dir',di,'dot to C7',closer_to(C7,C5,di))\nfor labels, di in [('C6',d6a),('C6',d6b)]: print(labels,'dir',di,'dot to C7',closer_to(C7,C6,di))\n\n# choose C8/9 direction: endo = toward C7, exo = away. H5/H6 are the opposite direction at each.\nC5_endodir = max([d5a,d5b], key=lambda d: closer_to(C7,C5,d))\nC6_endodir = max([d6a,d6b], key=lambda d: closer_to(C7,C6,d))\nC5_exodir = min([d5a,d5b], key=lambda d: closer_to(C7,C5,d))\nC6_exodir = min([d6a,d6b], key=lambda d: closer_to(C7,C6,d))\n\nfor mode in ['endo','exo']:\n    if mode=='endo':\n        dir5=C5_endodir; dir6=C6_endodir\n    else:\n        dir5=C5_exodir; dir6=C6_exodir\n    H5=add(C5,mul(mul(dir5,-1),1.10))\n    H6=add(C6,mul(mul(dir6,-1),1.10))\n    C8=add(C5,mul(dir5,1.50))\n    C9=add(C6,mul(dir6,1.50))\n    print('\\nMODE',mode)\n    print('H5-H7 distances', [round(norm(sub(H5,h)),2) for h in H7])\n    print('H6-H7 distances', [round(norm(sub(H6,h)),2) for h in H7])\n    # methyl H positions\n    H2=methyl_h_positions(C2Me, sub(C2Me,C2))\n    H3=methyl_h_positions(C3Me, sub(C3Me,C3))\n    H1=methyl_h_positions(C1Me, sub(C1Me,C1))\n    H4=methyl_h_positions(C4Me, sub(C4Me,C4))\n    def mind(H, methyl_Hs):\n        return min(norm(sub(H,h)) for h in methyl_Hs)\n    print('min H5 to C1Me/C4Me/C2Me/C3Me:', [round(mind(H5,hs),2) for hs in [H1,H4,H2,H3]])\n    print('min H6 to C1Me/C4Me/C2Me/C3Me:', [round(mind(H6,hs),2) for hs in [H1,H4,H2,H3]])\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
