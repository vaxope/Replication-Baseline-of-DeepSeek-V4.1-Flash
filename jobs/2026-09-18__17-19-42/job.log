Sending keys: ["python3 - <<'PY'\nimport numpy as np\n\ndef chirality(center, p1, p2, p3, p4):\n    # p4 is lowest priority. Compute signed volume for priorities 1,2,3,4.\n    v1=np.array(p1)-np.array(p4)\n    v2=np.array(p2)-np.array(p4)\n    v3=np.array(p3)-np.array(p4)\n    det=np.linalg.det(np.array([v1,v2,v3]))\n    # Earlier test: det>0 means S, det<0 means R (for this convention).\n    return 'S' if det>0 else 'R', det\n\n# Simplified planar ring coordinates\nC1=np.array([0,1,0])\nC2=np.array([-1,0.5,0])\nC3=np.array([-1,-0.5,0])\nC4=np.array([0,-1,0])\nC5=np.array([1,-0.5,0])\nC6=np.array([1,0.5,0])\n\n# +z = same face (methyl above); -z = other face\nfor label, z5, z6 in [('cis methyls (both above)', 1.0, 1.0),\n                      ('trans methyls (opposite faces)', 1.0, -1.0)]:\n    # At C5 priorities: C6 > C4 > Cmethyl > H\n    p1=C6; p2=C4; p3=C5+np.array([0,0,z5]); p4=C5+np.array([0,0,-z5])\n    c5, d5 = chirality(C5, p1, p2, p3, p4)\n    # At C6 priorities: C1 > C5 > Cmethyl > H\n    p1=C1; p2=C5; p3=C6+np.array([0,0,z6]); p4=C6+np.array([0,0,-z6])\n    c6, d6 = chirality(C6, p1, p2, p3, p4)\n    print(label, '=> C5', c5, 'C6', c6, '(dets', d5, d6, ')')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
