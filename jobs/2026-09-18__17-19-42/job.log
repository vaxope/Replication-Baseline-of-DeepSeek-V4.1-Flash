u1,v1,ax1,eq1=ringdirs[0]\n        O1=ax1 if c1_ox_ax else eq1\n        CH3=eq1 if c1_ox_ax else ax1\n        D1=det3(O1,u1,v1)  # priorities O,C2,C6,Me\n        conf1='S' if D1>0 else 'R'\n        for c2_ox_ax in [True,False]:\n            u2,v2,ax2,eq2=ringdirs[1]\n            O2=ax2 if c2_ox_ax else eq2\n            H2=eq2 if c2_ox_ax else ax2\n            D2=det3(O2,u2,v2)  # priorities O,C1,C3,H\n            conf2='S' if D2>0 else 'R'\n            print('C4 iPr %-3s | C1 O %-3s => %s | C2 O %-3s => %s | final configs %s%s%s'%(\n                'ax' if c4_ax else 'eq', 'ax' if c1_ox_ax else 'eq', conf1, 'ax' if c2_ox_ax else 'eq', conf2, conf1,conf2,conf4))\nPY\npython3 /tmp/geom2.py\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
