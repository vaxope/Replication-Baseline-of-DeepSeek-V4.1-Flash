Sending keys: ["python3 - <<'EOF'\nimport math\n\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef add(a,b): return tuple(x+y for x,y in zip(a,b))\ndef mul(a,s): return tuple(x*s for x in a)\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef norm(a):\n    l=math.sqrt(dot(a,a)); return tuple(x/l for x in a)\ndef unit(v): return norm(v)\ndef neg(v): return tuple(-x for x in v)\n\ndef rs(center, ligs):\n    vs={p:unit(sub(xyz,center)) for (_,xyz,p) in ligs}\n    v4=vs[4]\n    a=(1.0,0.0,0.0) if abs(v4[0])<0.9 else (0.0,1.0,0.0)\n    e1=unit(cross(v4,a))\n    e2=cross(v4,e1)\n    pts=[]\n    for p in (1,2,3):\n        v=vs[p]\n        pts.append((dot(v,e1), dot(v,e2)))\n    (x1,y1),(x2,y2),(x3,y3)=pts\n    s=(x2-x1)*(y3-y1)-(y2-y1)*(x3-x1)\n    return ('R' if s<0 else 'S'), s\n\n# Cage with two-carbon bridges front/back and bridge carbon top\nC8=(0.0,0.0,1.05)\nC4=(-1.0,0.0,0.35)\nC7=( 1.0,0.0,0.35)\nC5=(-0.70,-1.00,-0.25) # alkene left\nC6=( 0.70,-1.00,-0.25) # alkene right\nC3a=(-0.70,1.00,-0.25) # maleic left\nC7a=( 0.70,1.00,-0.25) # maleic right\n\n# crude carbonyl carbons: endo carbonyls are on +z face (same side as bridge C8)\nC1=(-1.15,1.35,0.55) # attached to C3a\nC3=( 1.15,1.35,0.55) # attached to C7a\n# hydrogens on bridgeheads via opposite sum\ndef opposite_sum(center, neigh, ln=1.0):\n    v=add(add(sub(neigh[0],center),sub(neigh[1],center)),sub(neigh[2],center))\n    return add(center,mul(unit(neg(v)),ln))\nHC4=opposite_sum(C4,[C8,C5,C3a],0.8)\nHC7=opposite_sum(C7,[C8,C6,C7a],0.8)\n# hydrogens on maleic carbons: exo (-z) placed by opposite sum of heavy neighbors\nHC3a=opposite_sum(C3a,[C7a,C4,C1],0.8)\nHC7a=opposite_sum(C7a,[C3a,C7,C3],0.8)\n\nprint('C4 (priorities C3a > C8 > C5 > H):', rs(C4,[('C3a',C3a,1),('C8',C8,2),('C5',C5,3),('H',HC4,4)]))\nprint('C7 (priorities C7a > C8 > C6 > H):', rs(C7,[('C7a',C7a,1),('C8',C8,2),('C6',C6,3),('H',HC7,4)]))\nprint('C3a (priorities C1 > C7a > C4 > H):', rs(C3a,[('C1',C1,1),('C7a',C7a,2),('C4',C4,3),('H',HC3a,4)]))\nprint('C7a (priorities C3 > C3a > C7 > H):', rs(C7a,[('C3',C3,1),('C3a',C3a,2),('C7',C7,3),('H',HC7a,4)]))\n\n# C8 substituents: one direction toward anhydride bridge (endo) = +y (C3a/C7a side), one toward alkene bridge (-y)\nv_endo=unit((0.0,1.0,1.0))   # toward anhydride side\nv_exo=unit((0.0,-1.0,1.0))   # toward alkene side\nF_endo=add(C8,mul(v_endo,1.0)); H_endo=add(C8,mul(v_exo,1.0))\nF_exo =add(C8,mul(v_exo,1.0)); H_exo =add(C8,mul(v_endo,1.0))\n\nprint('\\nC8 descriptors (use C4/C7 priorities from above):')\nfor name,Fpos,Hpos in [('F toward anhydride',F_endo,H_endo),('F toward alkene',F_exo,H_exo)]:\n    # first use C4 > C7 if C4 R and C7 S; otherwise reverse\n    desc4,_=rs(C4,[('C3a',C3a,1),('C8',C8,2),('C5',C5,3),('H',HC4,4)])\n    desc7,_=rs(C7,[('C7a',C7a,1),('C8',C8,2),('C6',C6,3),('H',HC7,4)])\n    if desc4=='R' and desc7=='S':\n        order=('C4(R)>C7(S)',C4,C7)\n    elif desc4=='S' and desc7=='R':\n        order=('C7(R)>C4(S)',C7,C4)\n    else:\n        order=('C4 assumed > C7',C4,C7)\n    d,s=rs(C8,[('F',Fpos,1),(order[0],order[1],2),(order[0]+'other',order[2],3),('H',Hpos,4)])\n    print(name, 'priority order', order[0], '=>', d, 's=', round(s,3))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
