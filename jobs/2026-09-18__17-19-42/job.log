\n\nfor i,j in [('C1','C2'),('C1','C6'),('C1','C7'),('C2','C3'),('C3','C4'),('C4','C5'),('C4','C7'),('C5','C6')]:\n    d=norm(sub({'C1':C1,'C2':C2,'C3':C3,'C4':C4,'C5':C5,'C6':C6,'C7':C7}[i], {'C1':C1,'C2':C2,'C3':C3,'C4':C4,'C5':C5,'C6':C6,'C7':C7}[j]))\n    print('bond',i,j,round(d,3))\n\n# C7 hydrogens from bonds to C1,C4\nh7d=tetra_dirs(sub(C1,C7),sub(C4,C7))\nH7=[add(C7,mul(d,1.10)) for d in h7d]\nprint('H7 positions',H7)\n\n# C5 directions\nd5=tetra_dirs(sub(C4,C5),sub(C6,C5))\n# C6 directions\nd6=tetra_dirs(sub(C1,C6),sub(C5,C6))\nprint('C5 dirs',d5)\nprint('C6 dirs',d6)\n\n# methyl carbons on C2,C3,C1,C4 (bond ~1.50)\nmc2=unit(mul(add(unit(sub(C1,C2)),unit(sub(C3,C2))),-1))\nC2Me=add(C2,mul(mc2,1.50))\nmc3=unit(mul(add(unit(sub(C4,C3)),unit(sub(C2,C3))),-1))\nC3Me=add(C3,mul(mc3,1.50))\nmc1=unit(mul(add(add(unit(sub(C2,C1)),unit(sub(C6,C1))),unit(sub(C7,C1))),-1))\nC1Me=add(C1,mul(mc1,1.50))\nmc4=unit(mul(add(add(unit(sub(C3,C4)),unit(sub(C5,C4))),unit(sub(C7,C4))),-1))\nC4Me=add(C4,mul(mc4,1.50))\n\nfor label,Cme,Cparent in [('C1Me',C1Me,C1),('C2Me',C2Me,C2),('C3Me',C3Me,C3),('C4Me',C4Me,C4)]:\n    hs=methyl_h_positions(Cme,Cparent)\n    # store later in globals? build dict below\n    globals()[label+'_H']=hs\n\ndef mind(H,hs): return min(norm(sub(H,h)) for h in hs)\ndef dd(a,b): return norm(sub(a,b))\n\n# Try all cis combinations for C8,C9 directions and print geometry\nfor ia,da in enumerate(d5):\n  for ib,db in enumerate(d6):\n    C8=add(C5,mul(da,1.50))\n    C9=add(C6,mul(db,1.50))\n    H5=add(C5,mul(mul(da,-1),1.10))\n    H6=add(C6,mul(mul(db,-1),1.10))\n    print('\\ncombo C5dir%d C6dir%d C8-C9 dist %.2f'%(ia,ib,dd(C8,C9)))\n    print(' H5-H7', [round(dd(H5,h),2) for h in H7])\n    print(' H6-H7', [round(dd(H6,h),2) for h in H7])\n    print(' H5-methyl mins C1,C4,C2,C3', [round(mind(H5,globals()[x+'_H']),2) for x in ['C1Me','C4Me','C2Me','C3Me']])\n    print(' H6-methyl mins C1,C4,C2,C3', [round(mind(H6,globals()[x+'_H']),2) for x in ['C1Me','C4Me','C2Me','C3Me']])\nPY\npython3 /tmp/norbornene_model.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
