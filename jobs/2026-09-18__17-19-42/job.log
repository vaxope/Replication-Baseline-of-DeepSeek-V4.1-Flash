Sending keys: ["python3 - <<'EOF'\nimport math\n\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef add(a,b): return tuple(x+y for x,y in zip(a,b))\ndef mul(a,s): return tuple(x*s for x in a)\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef norm(a):\n    l=math.sqrt(dot(a,a)); return tuple(x/l for x in a)\ndef unit(v): return norm(v)\ndef neg(v): return tuple(-x for x in v)\n\n# Function returns proper R/S: calibrate with known arrangement 1=(1,0,0),2=(0,1,0),3=(0,0,1),4=(0,0,-1) -> S.\ndef rs(center, ligs):\n    vs={p:unit(sub(xyz,center)) for (_,xyz,p) in ligs}\n    v4=vs[4]\n    a=(1.0,0.0,0.0) if abs(v4[0])<0.9 else (0.0,1.0,0.0)\n    e1=unit(cross(v4,a))\n    e2=cross(v4,e1)\n    pts=[]\n    for p in (1,2,3):\n        v=vs[p]\n        pts.append((dot(v,e1), dot(v,e2)))\n    (x1,y1),(x2,y2),(x3,y3)=pts\n    s=(x2-x1)*(y3-y1)-(y2-y1)*(x3-x1)\n    return ('S' if s<0 else 'R'), s\n\n# calibration\nprint('calibration (known S):', rs((0,0,0),[('1',(1,0,0),1),('2',(0,1,0),2),('3',(0,0,1),3),('4',(0,0,-1),4)]))\n\nP4=(-1.0,0.0,0.0)\nP7=( 1.0,0.0,0.0)\nP8=( 0.0,0.0,1.2)\nP5=(-0.7,-1.0,-0.3)\nP6=( 0.7,-1.0,-0.3)\nP3a=(-0.7,1.0,-0.3)\nP7a=( 0.7,1.0,-0.3)\n\ndef opposite_sum(center, neigh, ln=1.0):\n    s=(0,0,0)\n    for n in neigh: s=add(s,sub(n,center))\n    return add(center,mul(unit(neg(s)),ln))\n\nH4=opposite_sum(P4,[P8,P3a,P5],0.8)\nH7=opposite_sum(P7,[P8,P7a,P6],0.8)\n\nprint('\\nC4 priority C8>C3a>C5>H:', rs(P4,[('C8',P8,1),('C3a',P3a,2),('C5',P5,3),('H',H4,4)]))\nprint('C7 priority C8>C7a>C6>H:', rs(P7,[('C8',P8,1),('C7a',P7a,2),('C6',P6,3),('H',H7,4)]))\n\n# Endo: C1/C3 toward front (-y). Exo: toward back (+y)\nfor mode in ['endo','exo']:\n    if mode=='endo':\n        C1=(-0.9,-0.2,-0.8)\n        C3=( 0.9,-0.2,-0.8)\n    else:\n        C1=(-0.9, 1.8,-0.8)\n        C3=( 0.9, 1.8,-0.8)\n    H3a=opposite_sum(P3a,[P4,P7a,C1],0.8)\n    H7a=opposite_sum(P7a,[P7,P3a,C3],0.8)\n    # Potential priority orders at C3a: carbonyl (1) > other ring junction (2) > bridgehead (3) > H (4)\n    d3a=rs(P3a,[('C1',C1,1),('C7a',P7a,2),('C4',P4,3),('H',H3a,4)])\n    d7a=rs(P7a,[('C3',C3,1),('C3a',P3a,2),('C7',P7,3),('H',H7a,4)])\n    print(mode, 'C3a with C7a>C4:', d3a, ' C7a with C3a>C7:', d7a)\n    # alternative priority order at fusion carbons\n    d3a2=rs(P3a,[('C1',C1,1),('C4',P4,2),('C7a',P7a,3),('H',H3a,4)])\n    d7a2=rs(P7a,[('C3',C3,1),('C7',P7,2),('C3a',P3a,3),('H',H7a,4)])\n    print(mode, 'C3a with C4>C7a:', d3a2, ' C7a with C7>C3a:', d7a2)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
