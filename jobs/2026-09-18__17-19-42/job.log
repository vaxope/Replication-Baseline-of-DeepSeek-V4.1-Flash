arent):\n    axis=unit(sub(Cme,Cparent))\n    trial=(0,0,1) if abs(dot(axis,(0,0,1)))<0.9 else (0,1,0)\n    p=unit(sub(trial,mul(axis,dot(trial,axis))))\n    q=unit(cross(axis,p))\n    ct=math.cos(math.radians(109.5)); st=math.sin(math.radians(109.5))\n    hs=[]\n    for k in range(3):\n        psi=2*math.pi*k/3\n        hd=add(mul(axis,-ct),add(mul(p,st*math.cos(psi)),mul(q,st*math.sin(psi))))\n        hs.append(add(Cme,mul(hd,1.09)))\n    return hs\nMETH={'C1Me':methyl_hs(me1,C1),'C2Me':methyl_hs(me2,C2),'C3Me':methyl_hs(me3,C3),'C4Me':methyl_hs(me4,C4)}\n\nfor mode in ['endo-carbonyls','exo-carbonyls']:\n    if mode=='endo-carbonyls':\n        n5=d5[0]; n6=d6[0]  # substituent endo\n    else:\n        n5=d5[1]; n6=d6[1]  # H endo; carbonyl exo\n    C8=add(C5,mul(n5,1.50)); C9=add(C6,mul(n6,1.50))\n    H5=add(C5,mul(mul(n5,-1),1.09)); H6=add(C6,mul(mul(n6,-1),1.09))\n    print('\\n---',mode,'---')\n    print('C8-C9 distance',round(dist(C8,C9),2),'H5-H7',[round(dist(H5,h),2) for h in H7],'H6-H7',[round(dist(H6,h),2) for h in H7])\n    for hname,H in [('H5',H5),('H6',H6)]:\n        vals={}\n        for mname,hs in METH.items():\n            vals[mname]=round(min(dist(H,h) for h in hs),2)\n        print(hname,'closest methyl-H distances',vals)\n    # Also check H to methyl carbons\n    for hname,H in [('H5',H5),('H6',H6)]:\n        print(hname,'to methyl C distances', {n:round(dist(H,c),2) for n,c in [('C1Me',me1),('C2Me',me2),('C3Me',me3),('C4Me',me4)]})\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
