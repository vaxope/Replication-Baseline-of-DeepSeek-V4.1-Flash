Sending keys: ["python3 - <<'EOF'\nimport math\n\ndef sub(a,b): return tuple(x-y for x,y in zip(a,b))\ndef add(a,b): return tuple(x+y for x,y in zip(a,b))\ndef mul(a,s): return tuple(x*s for x in a)\ndef dot(a,b): return sum(x*y for x,y in zip(a,b))\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\ndef norm(a):\n    l=math.sqrt(dot(a,a)); return tuple(x/l for x in a)\ndef unit(v): return norm(v)\n\ndef rs(center, ligs):\n    # ligs list of (label, coords, priority 1=highest..4=lowest)\n    vs={p:unit(sub(xyz,center)) for (_,xyz,p) in ligs}\n    v4=vs[4]\n    k=(0.0,0.0,-1.0)\n    a=(1.0,0.0,0.0) if abs(v4[0])<0.9 else (0.0,1.0,0.0)\n    e1=unit(cross(v4,a))\n    e2=cross(k,e1)\n    xy=[]\n    for p in (1,2,3):\n        v=vs[p]\n        xy.append((dot(v,e1), dot(v,e2)))\n    (x1,y1),(x2,y2),(x3,y3)=xy\n    s=(x2-x1)*(y3-y1)-(y2-y1)*(x3-x1)\n    return 'R' if s<0 else 'S', s\n\n# Bicyclic cage coordinates: A=C4 left, D=C7 right, C8 bridge top.\nC8=(0.0,0.0,1.0)\nA=(-0.98,0.0,0.31)   # C4\nD=( 0.98,0.0,0.31)   # C7\nB=(-0.72,1.05,0.25)  # C5\nC=( 0.72,1.05,0.25)  # C6\nE=(-0.72,-1.05,0.25) # C3a\nF=( 0.72,-1.05,0.25) # C7a\n\n# Endo anhydride/carbonyls: towards C8 (+z side relative to E/F)\nG=(-0.85,-1.45,1.25) # carbonyl C attached to C3a\nHc=(0.85,-1.45,1.25) # carbonyl C attached to C7a\nExoG=(-0.85,-1.45,-0.65)\nExoHc=(0.85,-1.45,-0.65)\n\ndef opposite_sum(center, neighbors, length=1.0):\n    s=(0.0,0.0,0.0)\n    for n in neighbors: s=add(s,sub(n,center))\n    return add(center, mul(unit(s), -length))\n\nHA=opposite_sum(A,[B,E,C8],0.8)\nHD=opposite_sum(D,[C,F,C8],0.8)\nHB=opposite_sum(B,[A,C,C],0.8) # C is alkene carbon\nHC=opposite_sum(C,[D,B,B],0.8)\nHE=opposite_sum(E,[A,F,G],0.8)\nHF=opposite_sum(F,[D,E,Hc],0.8)\n\n# approximate bridge hydrogens depending on F orientation\n# tetrahedral C8 directions from local C8: v1 +y/up, v2 -y/up\nv_BC=unit((0.0, 1.0, 1.0))   # exo side toward alkene bridge\nv_EF=unit((0.0,-1.0, 1.0))   # endo side toward anhydride bridge\nF_endo=add(C8,mul(v_EF,1.0))\nH_endo=add(C8,mul(v_BC,1.0))\nF_exo=add(C8,mul(v_BC,1.0))\nH_exo=add(C8,mul(v_EF,1.0))\n\nprint('Bridge descriptors:')\nfor name,Fpos,Hpos in [('F endo',F_endo,H_endo),('F exo',F_exo,H_exo)]:\n    # at C8 priorities: F=1; R ring center outranks S; 4=H\n    # We'll compute both possible priority orders and see.\n    for order in [('C7R over C4S', D, A), ('C4R over C7S', A, D)]:\n        desc,s=rs(C8,[('F',Fpos,1),(order[0],order[1],2),(order[0],order[2],3),('H',Hpos,4)])\n        print(name, 'order', order[0], '=>', desc, 's=',round(s,3))\n\nprint('\\nCore descriptors with endo G/Hc:')\nprint('C4', rs(A,[('C8',C8,1),('E',E,2),('B',B,3),('H',HA,4)]))\nprint('C7', rs(D,[('C8',C8,1),('F',F,2),('C',C,3),('H',HD,4)]))\nprint('C3a', rs(E,[('G',G,1),('F',F,2),('A',A,3),('H',HE,4)]))\nprint('C7a', rs(F,[('Hc',Hc,1),('E',E,2),('D',D,3),('H',HF,4)]))\n\nprint('\\nCore descriptors with exo G/Hc:')\nprint('C4', rs(A,[('C8',C8,1),('E',E,2),('B',B,3),('H',HA,4)]))\nprint('C7', rs(D,[('C8',C8,1),('F',F,2),('C',C,3),('H',HD,4)]))\nprint('C3a', rs(E,[('ExoG',ExoG,1),('F',F,2),('A',A,3),('H',HE,4)]))\nprint('C7a', rs(F,[('ExoHc',ExoHc,1),('E',E,2),('D',D,3),('H',HF,4)]))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
