Sending keys: ["python3 - <<'PY'\nimport math\n\nSQ3=math.sqrt(3.0)\nh=1.0/(4.0*math.sqrt(2.0))\n# ideal chair coordinates\nC={\n 1:(1,0,h), 2:(0.5,SQ3/2,-h), 3:(-0.5,SQ3/2,h),\n 4:(-1,0,-h), 5:(-0.5,-SQ3/2,h), 6:(0.5,-SQ3/2,-h)\n}\n\ndef sub(a,b): return (a[0]-b[0],a[1]-b[1],a[2]-b[2])\ndef add(a,b): return (a[0]+b[0],a[1]+b[1],a[2]+b[2])\ndef mul(a,s): return (a[0]*s,a[1]*s,a[2]*s)\ndef dot(a,b): return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\ndef cross(a,b): return (a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0])\ndef norm(a):\n    l=math.sqrt(dot(a,a)); return (a[0]/l,a[1]/l,a[2]/l)\n\ndef subst_dirs(center, n1, n2):\n    a=norm(sub(C[n1],center)); b=norm(sub(C[n2],center))\n    u=add(a,b); c=dot(a,b)\n    n=cross(a,b); n=norm(n)\n    q=mul(n, math.sqrt((1-c)/2.0))\n    x=add(mul(u,-0.5), q)\n    y=add(mul(u,-0.5), mul(q,-1))\n    return x,y\n\ndef det3(a,b,c):\n    return (a[0]*(b[1]*c[2]-b[2]*c[1])\n           -a[1]*(b[0]*c[2]-b[2]*c[0])\n           +a[2]*(b[0]*c[1]-b[1]*c[0]))\n\ndef chirality(center, p1, p2, p3, p4):\n    v1=sub(p1,p4); v2=sub(p2,p4); v3=sub(p3,p4)\n    d=det3(v1,v2,v3)\n    return ('S' if d>0 else 'R'), d\n\nfor methyl_z_sign in (1,-1):\n    dirs5=subst_dirs(C[5],4,6)\n    dirs6=subst_dirs(C[6],1,5)\n    # choose the substituent direction with desired global z sign as methyl\n    me5=dirs5[0] if dirs5[0][2]*methyl_z_sign>0 else dirs5[1]\n    h5=dirs5[1] if me5 is dirs5[0] else dirs5[0]\n    me6=dirs6[0] if dirs6[0][2]*methyl_z_sign>0 else dirs6[1]\n    h6=dirs6[1] if me6 is dirs6[0] else dirs6[0]\n    # atom positions\n    Pme5=add(C[5], mul(me5,1.5)); Ph5=add(C[5], mul(h5,1.0))\n    Pme6=add(C[6], mul(me6,1.5)); Ph6=add(C[6], mul(h6,1.0))\n    # C5 priorities: 1=C6,2=C4,3=Me,4=H\n    c5,d5=chirality(C[5], C[6], C[4], Pme5, Ph5)\n    # C6 priorities: 1=C1,2=C5,3=Me,4=H\n    c6,d6=chirality(C[6], C[1], C[5], Pme6, Ph6)\n    print('methyls z-sign', methyl_z_sign, 'C5',c5,'C6',c6,'dets',round(d5,3),round(d6,3))\nPY\n"] min_timeout_sec: 1.0 